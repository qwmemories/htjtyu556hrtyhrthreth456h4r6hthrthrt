function ui:SetupInputs()
    local UIS = self.UIS
    local mouse = self.mouse
    
    -- Drag window
    self.mf.InputBegan:Connect(function(i)
        if self.isSliding then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            self.isDragging = true
            self.dragStart = i.Position
            self.startPos = self.mf.Position
            self.targetPos = self.mf.Position
        end
    end)
    
    UIS.InputChanged:Connect(function(i)
        if self.isDragging and not self.isSliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - self.dragStart
            self.targetPos = UDim2.new(
                self.startPos.X.Scale, 
                self.startPos.X.Offset + d.X,
                self.startPos.Y.Scale, 
                self.startPos.Y.Offset + d.Y
            )
        end
        
        -- Slider dragging
        if self.draggingSpeed or self.draggingJump or self.draggingFlight or self.draggingStrafe or self.draggingSmooth or self.draggingRange then
            for id, data in pairs(self.sliders) do
                local dragKey = "dragging" .. id:upper()
                if self[dragKey] then
                    local s = data.slider.AbsoluteSize.X
                    if s > 0 then
                        local v = math.clamp((i.Position.X - data.slider.AbsolutePosition.X) / s, 0, 1)
                        data.fill.Size = UDim2.new(v, 0, 1, 0)
                        data.handle.Position = UDim2.new(v, -8, 0.5, -8)
                        if id == "sp" and self.callbacks.updateSpeed then 
                            self.callbacks.updateSpeed(v)
                            if data.value then data.value.Text = "Value: " .. math.floor(self.minSpeed + (self.maxSpeed - self.minSpeed) * v + 0.5) end
                        elseif id == "j" and self.callbacks.updateJump then 
                            self.callbacks.updateJump(v)
                            if data.value then data.value.Text = "Strength: " .. math.floor(self.minJump + (self.maxJump - self.minJump) * v + 0.5) end
                        elseif id == "f" and self.callbacks.updateFlight then 
                            self.callbacks.updateFlight(v)
                            if data.value then data.value.Text = "Speed: " .. math.floor(self.minFlight + (self.maxFlight - self.minFlight) * v + 0.5) end
                        elseif id == "st" and self.callbacks.updateStrafe then 
                            self.callbacks.updateStrafe(v)
                            if data.value then data.value.Text = "Value: " .. math.floor(self.minStrafe + (self.maxStrafe - self.minStrafe) * v + 0.5) end
                        elseif id == "sm" and self.callbacks.updateSmooth then 
                            self.callbacks.updateSmooth(v)
                            if data.value then data.value.Text = "Speed: " .. string.format("%.2f", self.minSmooth + (self.maxSmooth - self.minSmooth) * v) end
                        elseif id == "r" and self.callbacks.updateRange then 
                            self.callbacks.updateRange(v)
                            if data.value then data.value.Text = "Range: " .. math.floor(self.minRange + (self.maxRange - self.minRange) * v + 0.5) end
                        end
                    end
                end
            end
        end
    end)
    
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            self.isDragging = false
            self.isSliding = false
            self.draggingSpeed = false
            self.draggingJump = false
            self.draggingFlight = false
            self.draggingStrafe = false
            self.draggingSmooth = false
            self.draggingRange = false
        end
    end)
    
    -- Drag update
    self.RS.RenderStepped:Connect(function()
        if self.targetPos then
            local c = self.mf.Position
            local dx = self.targetPos.X.Offset - c.X.Offset
            local dy = self.targetPos.Y.Offset - c.Y.Offset
            if math.abs(dx) > 0.5 or math.abs(dy) > 0.5 then
                self.mf.Position = UDim2.new(
                    c.X.Scale, c.X.Offset + dx * 0.18,
                    c.Y.Scale, c.Y.Offset + dy * 0.18
                )
            end
        end
    end)
    
    -- Keybinds
    UIS.InputBegan:Connect(function(i, p)
        if p then return end
        if self.bindListening then
            if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode ~= Enum.KeyCode.Unknown then
                local name = self.bindListening
                self.binds[name] = i.KeyCode
                self.bindListening = nil
                local row = self.bindRows[name]
                if row then
                    row.bind.Text = i.KeyCode.Name
                    row.bind.TextColor3 = Color3.new(1, 1, 1)
                end
                return
            end
        end
        
        if i.UserInputType == Enum.UserInputType.Keyboard then
            for name, key in pairs(self.binds) do
                if key == i.KeyCode then
                    local callbackName = "toggle" .. name:gsub(" ", "")
                    if name == "ClickTP" then callbackName = "toggleClickTp" end
                    if self.callbacks[callbackName] then
                        self.callbacks[callbackName]()
                    end
                end
            end
        end
    end)
end

function ui:SetupScroll()
    local contentViewport = self.contentViewport
    contentViewport.ScrollingEnabled = false
    
    local SCROLL_STEP = 24
    local SCROLL_SMOOTHNESS = 0.12
    
    local function activeContent()
        if self.currentCategory == "movement" then return self.mc
        elseif self.currentCategory == "misc" then return self.miscC
        else return self.bindC end
    end
    
    local function contentBottom(content)
        local bottom = 0
        for _, obj in ipairs(content:GetChildren()) do
            if obj:IsA("GuiObject") and obj.Visible then
                local y = obj.Position.Y.Offset + obj.AbsoluteSize.Y
                if y > bottom then bottom = y end
            end
        end
        return bottom
    end
    
    local function isMouseOverViewport()
        local p = self.UIS:GetMouseLocation()
        local pos = contentViewport.AbsolutePosition
        local size = contentViewport.AbsoluteSize
        return p.X >= pos.X and p.X <= pos.X + size.X and p.Y >= pos.Y and p.Y <= pos.Y + size.Y
    end
    
    local function calculateScroll()
        local content = activeContent()
        local viewportH = contentViewport.AbsoluteSize.Y
        local bottom = contentBottom(content)
        local canvasHeight = math.max(bottom, viewportH)
        contentViewport.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)
        local maxScroll = math.max(0, bottom - viewportH)
        self.scrollMax = maxScroll
        return bottom, viewportH, maxScroll
    end
    
    local function updateScrollBar()
        if self.isHidden or self.isAnimating or not self.mf.Visible then
            self.scrollTrack.Visible = false
            self.scrollThumb.Visible = false
            return
        end
        
        local bottom, viewportH, maxScroll = calculateScroll()
        
        if maxScroll <= 0 then
            self.scrollTarget = 0
            self.scrollCurrent = 0
            contentViewport.CanvasPosition = Vector2.new(0, 0)
            self.scrollTrack.Visible = false
            self.scrollThumb.Visible = false
            return
        end
        
        self.scrollTarget = math.clamp(self.scrollTarget, 0, maxScroll)
        self.scrollCurrent = math.clamp(self.scrollCurrent, 0, maxScroll)
        
        contentViewport.CanvasPosition = Vector2.new(0, self.scrollCurrent)
        
        self.scrollTrack.Visible = true
        self.scrollThumb.Visible = true
        
        local trackH = self.scrollTrack.AbsoluteSize.Y
        local thumbH = math.clamp(trackH * (viewportH / math.max(bottom, viewportH)), 36, trackH)
        self.scrollThumb.Size = UDim2.new(1, 0, 0, thumbH)
        
        local travel = math.max(0, trackH - thumbH)
        local ratio = maxScroll > 0 and self.scrollCurrent / maxScroll or 0
        self.scrollThumb.Position = UDim2.new(0, 0, 0, travel * math.clamp(ratio, 0, 1))
    end
    
    function self:RefreshScroll(resetPosition)
        calculateScroll()
        if resetPosition then
            self.scrollTarget = 0
            self.scrollCurrent = 0
        end
        contentViewport.CanvasPosition = Vector2.new(0, self.scrollCurrent)
        updateScrollBar()
    end
    
    -- Mouse wheel
    self.UIS.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
        if self.isHidden or self.isAnimating or not self.mf.Visible then return end
        if not isMouseOverViewport() then return end
        
        local _, _, maxScroll = calculateScroll()
        if maxScroll <= 0 then return end
        
        self.scrollTarget = math.clamp(self.scrollTarget - (input.Position.Z * SCROLL_STEP), 0, maxScroll)
    end)
    
    -- Scroll thumb drag
    self.scrollThumb.InputBegan:Connect(function(input)
        if self.isHidden or self.isAnimating then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.scrollDragging = true
            self.scrollDragStartY = input.Position.Y
            self.scrollDragStartCanvas = self.scrollCurrent
        end
    end)
    
    self.UIS.InputChanged:Connect(function(input)
        if not self.scrollDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if not self.scrollTrack.Visible then return end
        
        local trackH = self.scrollTrack.AbsoluteSize.Y
        local thumbH = self.scrollThumb.AbsoluteSize.Y
        local travel = math.max(1, trackH - thumbH)
        local delta = input.Position.Y - self.scrollDragStartY
        
        self.scrollTarget = math.clamp(self.scrollDragStartCanvas + (delta / travel) * self.scrollMax, 0, self.scrollMax)
        self.scrollCurrent = self.scrollTarget
        contentViewport.CanvasPosition = Vector2.new(0, self.scrollCurrent)
        updateScrollBar()
    end)
    
    self.UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.scrollDragging = false
        end
    end)
    
    -- Render loop for scroll
    self.RS.RenderStepped:Connect(function()
        if self.isHidden or self.isAnimating or not self.mf.Visible then
            self.scrollTrack.Visible = false
            self.scrollThumb.Visible = false
            return
        end
        
        local _, _, maxScroll = calculateScroll()
        if maxScroll <= 0 then
            self.scrollTarget = 0
            self.scrollCurrent = 0
            contentViewport.CanvasPosition = Vector2.new(0, 0)
            self.scrollTrack.Visible = false
            self.scrollThumb.Visible = false
            return
        end
        
        self.scrollTarget = math.clamp(self.scrollTarget, 0, maxScroll)
        self.scrollCurrent = self.scrollCurrent + (self.scrollTarget - self.scrollCurrent) * SCROLL_SMOOTHNESS
        
        if math.abs(self.scrollCurrent - self.scrollTarget) < 0.1 then
            self.scrollCurrent = self.scrollTarget
        end
        
        self.scrollCurrent = math.clamp(self.scrollCurrent, 0, maxScroll)
        contentViewport.CanvasPosition = Vector2.new(0, self.scrollCurrent)
        updateScrollBar()
    end)
end

function ui:SwitchCategory(c)
    if self.currentCategory == c then return end
    
    self.currentCategory = c
    self.scrollTarget = 0
    self.scrollCurrent = 0
    self.contentViewport.CanvasPosition = Vector2.new(0, 0)
    self.scrollTrack.Visible = false
    self.scrollThumb.Visible = false
    
    local inf = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if c == "movement" then
        self.TS:Create(self.movL, inf, {TextTransparency = 0}):Play()
        self.TS:Create(self.miscL, inf, {TextTransparency = 0.4}):Play()
        self.TS:Create(self.bindL, inf, {TextTransparency = 0.4}):Play()
        self.miscC.Visible = false
        self.mc.Visible = true
        self.bindC.Visible = false
    elseif c == "misc" then
        self.TS:Create(self.movL, inf, {TextTransparency = 0.4}):Play()
        self.TS:Create(self.miscL, inf, {TextTransparency = 0}):Play()
        self.TS:Create(self.bindL, inf, {TextTransparency = 0.4}):Play()
        self.mc.Visible = false
        self.miscC.Visible = true
        self.bindC.Visible = false
    else
        self.TS:Create(self.movL, inf, {TextTransparency = 0.4}):Play()
        self.TS:Create(self.miscL, inf, {TextTransparency = 0.4}):Play()
        self.TS:Create(self.bindL, inf, {TextTransparency = 0}):Play()
        self.mc.Visible = false
        self.miscC.Visible = false
        self.bindC.Visible = true
    end
    
    task.defer(function()
        task.wait()
        self:RefreshScroll(true)
    end)
end

function ui:SetMinimized(s)
    if self.isAnimating then return end
    
    self.isAnimating = true
    self.isHidden = s
    
    self.scrollTrack.Visible = false
    self.scrollThumb.Visible = false
    self.contentViewport.ScrollingEnabled = false
    
    local ts = s and UDim2.new(0, 350, 0, 30) or UDim2.new(0, 350, 0, 530)
    
    local tw = self.TS:Create(
        self.mf,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = ts}
    )
    
    if s then
        self.mc.Visible = false
        self.miscC.Visible = false
        self.bindC.Visible = false
        
        self:StartFps()
        
        self.TS:Create(
            self.fpsLabel,
            TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {TextTransparency = 0}
        ):Play()
    else
        self.TS:Create(
            self.fpsLabel,
            TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {TextTransparency = 1}
        ):Play()
    end
    
    tw:Play()
    
    tw.Completed:Connect(function()
        if not s then
            self.mc.Visible = self.currentCategory == "movement"
            self.miscC.Visible = self.currentCategory == "misc"
            self.bindC.Visible = self.currentCategory == "bind"
            self:RefreshScroll(true)
        end
        self.isAnimating = false
    end)
end

function ui:StartFps()
    if self.fpsConnection then return end
    local f = 0
    local l = tick()
    self.fpsConnection = self.RS.RenderStepped:Connect(function()
        f = f + 1
        local n = tick()
        if n - l >= 0.016 then
            self.fpsLabel.Text = "fps " .. math.floor(f / (n - l))
            f = 0
            l = n
        end
    end)
end

function ui:SetToggle(id, on, anim)
    local data = self.toggles and self.toggles[id]
    if not data then return end
    
    local pos = on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    local tc = on and Color3.new(0.5, 0.5, 0.5) or Color3.new(0.15, 0.15, 0.15)
    local kc = on and Color3.new(1, 1, 1) or Color3.new(0.6, 0.6, 0.6)
    
    if anim then
        local inf = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        self.TS:Create(data.toggleKnob, inf, {Position = pos, BackgroundColor3 = kc}):Play()
        self.TS:Create(data.toggleFrame, inf, {BackgroundColor3 = tc}):Play()
    else
        data.toggleKnob.Position = pos
        data.toggleKnob.BackgroundColor3 = kc
        data.toggleFrame.BackgroundColor3 = tc
    end
end

