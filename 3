-- ui.lua - UI Rendering
local ui = {}

function ui:Init(player, mouse, UIS, RS)
    self.player = player
    self.mouse = mouse
    self.UIS = UIS
    self.RS = RS
    self.PL = game:GetService("Players")
    self.TS = game:GetService("TweenService")
    
    -- Состояние UI
    self.isHidden = false
    self.isAnimating = false
    self.isDragging = false
    self.isSliding = false
    self.dragStart = nil
    self.startPos = nil
    self.targetPos = nil
    self.currentCategory = "movement"
    
    -- Состояние слайдеров
    self.draggingSpeed = false
    self.draggingJump = false
    self.draggingFlight = false
    self.draggingStrafe = false
    self.draggingSmooth = false
    self.draggingRange = false
    
    self.minSpeed, self.maxSpeed = 0, 500
    self.minJump, self.maxJump = 0, 500
    self.minFlight, self.maxFlight = 0, 500
    self.minStrafe, self.maxStrafe = 0, 100
    self.minSmooth, self.maxSmooth = 0.01, 1
    self.minRange, self.maxRange = 10, 1000
    
    self.scrollMax = 0
    self.scrollDragging = false
    self.scrollDragStartY = 0
    self.scrollDragStartCanvas = 0
    self.scrollTarget = 0
    self.scrollCurrent = 0
    
    self.fpsConnection = nil
    self.bindListening = nil
    self.binds = {}
    self.bindRows = {}
    
    -- Callback'и для логики
    self.callbacks = {}
    
    self:CreateUI()
    self:SetupInputs()
    self:SetupScroll()
end

function ui:SetLogicCallbacks(callbacks)
    self.callbacks = callbacks
end

