local function toggleNoclip()
	if not _G.flightEnabled then return end
	_G.noclipEnabled=not _G.noclipEnabled
	updateNoclip()
	if _G.noclipEnabled then
		if _G.flying then
			setNoclip(true)
			if not _G.noclipConnection then
				_G.noclipConnection=RS.Stepped:Connect(function() setNoclip(true) end)
			end
		end
	else
		if _G.noclipConnection then _G.noclipConnection:Disconnect() _G.noclipConnection=nil end
		setNoclip(false)
	end
end

