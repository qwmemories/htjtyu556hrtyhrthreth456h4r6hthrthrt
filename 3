function ui:CreateSlider(parent, labelText, valueText, y, id, defaultValue, minVal, maxVal)
    local y = y + 2
    
    -- Label
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 25)
    label.Position = UDim2.new(0, 10, 0, y)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(0.6, 0.6, 0.6)
    label.TextSize = 20
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    
    -- Toggle
    local toggleFrame, toggleKnob, toggleStroke, toggleClick = self:CreateToggleElement(parent, UDim2.new(0.75, 0, 0, y + 4))
    
    -- Value label
    local value = nil
    if valueText then
        value = Instance.new("TextLabel")
        value.Size = UDim2.new(0.5, 0, 0, 25)
        value.Position = UDim2.new(0, 10, 0, y + 32)
        value.BackgroundTransparency = 1
        value.Text = valueText
        value.TextColor3 = Color3.new(0.6, 0.6, 0.6)
        value.TextSize = 18
        value.Font = Enum.Font.Gotham
        value.TextXAlignment = Enum.TextXAlignment.Left
        value.Parent = parent
    end
    
    local sliderY = y + (valueText and 62 or 34)
    
    -- Slider
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.85, 0, 0, 8)
    slider.Position = UDim2.new(0.075, 0, 0, sliderY)
    slider.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
    slider.BorderSizePixel = 0
    slider.Parent = parent
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 4)
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(defaultValue, 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(0.6, 0.6, 0.6)
    fill.BorderSizePixel = 0
    fill.Parent = slider
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)
    
    local handle = Instance.new("Frame")
    handle.Size = UDim2.new(0, 16, 0, 16)
    handle.Position = UDim2.new(defaultValue, -8, 0.5, -8)
    handle.BackgroundColor3 = Color3.new(0.6, 0.6, 0.6)
    handle.BorderSizePixel = 0
    handle.Parent = slider
    Instance.new("UICorner", handle).CornerRadius = UDim.new(0, 8)
    
    -- Сохраняем элементы
    local sliderData = {
        label = label,
        value = value,
        slider = slider,
        fill = fill,
        handle = handle,
        toggleFrame = toggleFrame,
        toggleKnob = toggleKnob,
        toggleClick = toggleClick,
        id = id,
        minVal = minVal,
        maxVal = maxVal
    }
    
    self.sliders = self.sliders or {}
    self.sliders[id] = sliderData
    
    -- Обработчики для слайдера
    local function updateSlider(v)
        fill.Size = UDim2.new(v, 0, 1, 0)
        handle.Position = UDim2.new(v, -8, 0.5, -8)
    end
    
    local function updateValue(v)
        local val = minVal + (maxVal - minVal) * v
        if id == "sp" and self.callbacks.updateSpeed then 
            self.callbacks.updateSpeed(v)
            if value then value.Text = "Value: " .. math.floor(val + 0.5) end
        elseif id == "j" and self.callbacks.updateJump then 
            self.callbacks.updateJump(v)
            if value then value.Text = "Strength: " .. math.floor(val + 0.5) end
        elseif id == "f" and self.callbacks.updateFlight then 
            self.callbacks.updateFlight(v)
            if value then value.Text = "Speed: " .. math.floor(val + 0.5) end
        elseif id == "st" and self.callbacks.updateStrafe then 
            self.callbacks.updateStrafe(v)
            if value then value.Text = "Value: " .. math.floor(val + 0.5) end
        elseif id == "sm" and self.callbacks.updateSmooth then 
            self.callbacks.updateSmooth(v)
            if value then value.Text = "Speed: " .. string.format("%.2f", val) end
        elseif id == "r" and self.callbacks.updateRange then 
            self.callbacks.updateRange(v)
            if value then value.Text = "Range: " .. math.floor(val + 0.5) end
        end
    end
    
    local function getSliderValue(input)
        local s = slider.AbsoluteSize.X
        if s <= 0 then return 0 end
        return math.clamp((input.Position.X - slider.AbsolutePosition.X) / s, 0, 1)
    end
    
    local function onSliderInput(input)
        local v = getSliderValue(input)
        updateSlider(v)
        updateValue(v)
    end
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.isSliding = true
            self.isDragging = false
            local dragKey = "dragging" .. id:upper()
            self[dragKey] = true
            onSliderInput(input)
        end
    end)
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.isSliding = true
            self.isDragging = false
            local dragKey = "dragging" .. id:upper()
            self[dragKey] = true
            onSliderInput(input)
        end
    end)
    
    return y + 90
end

function ui:CreateToggle(parent, text, y, id)
    local y = y + 2
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 25)
    label.Position = UDim2.new(0, 10, 0, y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(0.6, 0.6, 0.6)
    label.TextSize = 20
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    
    local toggleFrame, toggleKnob, toggleStroke, toggleClick = self:CreateToggleElement(parent, UDim2.new(0.75, 0, 0, y + 4))
    
    self.toggles = self.toggles or {}
    self.toggles[id] = {
        label = label,
        toggleFrame = toggleFrame,
        toggleKnob = toggleKnob,
        toggleClick = toggleClick
    }
    
    local callbackName = "toggle" .. id:upper()
    if id == "n" then callbackName = "toggleNoclip" end
    if id == "aw" then callbackName = "toggleAirwalk" end
    if id == "c" then callbackName = "toggleClickTp" end
    if id == "aj" then callbackName = "toggleAirJump" end
    if id == "aim" then callbackName = "toggleAimbot" end
    if id == "tl" then callbackName = "toggleTargetLock" end
    if id == "wc" then callbackName = "toggleWallsCheck" end
    
    toggleClick.MouseButton1Click:Connect(function()
        if self.callbacks[callbackName] then
            self.callbacks[callbackName]()
        end
    end)
    
    return y + 40
end

