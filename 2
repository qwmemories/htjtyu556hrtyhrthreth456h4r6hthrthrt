local function setCategoryVisual(category)
	local inf=TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	local mov=category=="movement" and 0 or 0.4
	local misc=category=="misc" and 0 or 0.4
	local key=category=="keybind" and 0 or 0.4
	TS:Create(movL,inf,{TextTransparency=mov}):Play()
	TS:Create(miscL,inf,{TextTransparency=misc}):Play()
	TS:Create(keybindL,inf,{TextTransparency=key}):Play()
end

local function switchToKeybind()
	if _G.currentCategory=="keybind" then
		return
	end
	_G.currentCategory="keybind"
	keybindContent.Visible=true
	ui.mc.Visible=false
	ui.miscC.Visible=false
	ui.scrollTrack.Visible=false
	ui.scrollThumb.Visible=false
	setCategoryVisual("keybind")
	contentViewport.CanvasPosition=Vector2.new(0,0)
	task.defer(function()
		task.wait()
		if _G.currentCategory=="keybind" then
			contentViewport.CanvasSize=UDim2.new(0,0,0,math.max(keybindContent.AbsoluteSize.Y,contentViewport.AbsoluteSize.Y))
		end
	end)
end

