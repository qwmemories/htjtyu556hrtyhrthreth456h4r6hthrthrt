local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")
local mouse = player:GetMouse()
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local PL = game:GetService("Players")

repeat wait(0.1) until _G.speedEnabled ~= nil
wait(0.2)

local function setNoclip(s)
	if not character then return end
	for _, p in pairs(character:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = not s end
	end
end

function _G.startFlightFunc()
	if _G.flying or not root then return end
	_G.flying = true
	_G.bodyVelocity = Instance.new("BodyVelocity")
	_G.bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	_G.bodyVelocity.Velocity = Vector3.zero
	_G.bodyVelocity.Parent = root
	_G.bodyGyro = Instance.new("BodyGyro")
	_G.bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	_G.bodyGyro.P = 10000
	_G.bodyGyro.Parent = root
	humanoid.PlatformStand = true
	if _G.noclipEnabled then
		setNoclip(true)
		_G.noclipConnection = RS.Stepped:Connect(function() setNoclip(true) end)
	end
end

function _G.stopFlightFunc()
	_G.flying = false
	if _G.bodyVelocity then _G.bodyVelocity:Destroy() _G.bodyVelocity = nil end
	if _G.bodyGyro then _G.bodyGyro:Destroy() _G.bodyGyro = nil end
	if humanoid then humanoid.PlatformStand = false end
	if _G.noclipConnection then _G.noclipConnection:Disconnect() _G.noclipConnection = nil end
	setNoclip(false)
end

function _G.enableNoclipFunc()
	_G.noclipEnabled = true
	if _G.flying then
		setNoclip(true)
		if not _G.noclipConnection then
			_G.noclipConnection = RS.Stepped:Connect(function()
				if _G.flying and _G.noclipEnabled then
					setNoclip(true)
				end
			end)
		end
	end
end

function _G.disableNoclipFunc()
	_G.noclipEnabled = false
	if _G.noclipConnection then _G.noclipConnection:Disconnect() _G.noclipConnection = nil end
	setNoclip(false)
end

function _G.startAirwalkFunc()
	if _G.airwalkPlatform then return end
	_G.airwalkY = root.Position.Y - 3
	_G.airwalkPlatform = Instance.new("Part")
	_G.airwalkPlatform.Size = Vector3.new(6, 1, 6)
	_G.airwalkPlatform.Transparency = 1
	_G.airwalkPlatform.CanCollide = true
	_G.airwalkPlatform.Anchored = true
	_G.airwalkPlatform.Parent = workspace
end

function _G.stopAirwalkFunc()
	if _G.airwalkPlatform then _G.airwalkPlatform:Destroy() _G.airwalkPlatform = nil end
end

local function getTargets()
	local t = {}
	for _, p in pairs(PL:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
			local h = p.Character:FindFirstChild("Humanoid")
			if h and h.Health > 0 then table.insert(t, p) end
		end
	end
	return t
end

local function selectTarget(targets)
	if #targets == 0 then return nil end
	if _G.sortMode == "Distance" then
		table.sort(targets, function(a, b)
			local da = (a.Character.HumanoidRootPart.Position - root.Position).Magnitude
			local db = (b.Character.HumanoidRootPart.Position - root.Position).Magnitude
			return da < db
		end)
		return targets[1]
	else
		local mp = UIS:GetMouseLocation()
		table.sort(targets, function(a, b)
			local pa, oa = workspace.CurrentCamera:WorldToViewportPoint(a.Character.Head.Position)
			local pb, ob = workspace.CurrentCamera:WorldToViewportPoint(b.Character.Head.Position)
			if not oa then return false end
			if not ob then return true end
			return (Vector2.new(pa.X, pa.Y) - mp).Magnitude < (Vector2.new(pb.X, pb.Y) - mp).Magnitude
		end)
		return targets[1]
	end
end

local function isVisible(part)
	if not _G.wallsCheckEnabled then return true end
	local origin = workspace.CurrentCamera.CFrame.Position
	local direction = (part.Position - origin)
	local ray = workspace:Raycast(origin, direction)
	if ray and ray.Instance then
		local hitChar = ray.Instance:FindFirstAncestorOfClass("Model")
		if hitChar and hitChar:FindFirstChild("Humanoid") then
			return true
		else
			return false
		end
	end
	return true
end

local function getAimPart(target)
	if _G.aimTarget == "Head" then
		return target.Character.Head
	else
		return target.Character.HumanoidRootPart
	end
end

local colorTapPlus = nil
local function getColorTapPlus()
	if not colorTapPlus or not colorTapPlus.Parent then
		for _, v in pairs(player.PlayerGui:GetDescendants()) do
			if v:IsA("TextLabel") and v.Text == "+" and v.Visible then
				colorTapPlus = v
				break
			end
		end
	end
	return colorTapPlus
end

local function getPixelColor(position)
	local viewport = workspace.CurrentCamera.ViewportSize
	local x = math.clamp(position.X, 0, viewport.X - 1)
	local y = math.clamp(position.Y, 0, viewport.Y - 1)
	return workspace.CurrentCamera:GetPixels(x, y, 1, 1)[1]
end

local function colorDistance(c1, c2)
	local r = c1.R - c2.R
	local g = c1.G - c2.G
	local b = c1.B - c2.B
	return math.sqrt(r*r + g*g + b*b)
end

local function getScreenCenter()
	local size = workspace.CurrentCamera.ViewportSize
	return Vector2.new(size.X / 2, size.Y / 2)
end

local function isColorMatch(color1, color2, threshold)
	if not threshold then threshold = 0.05 end
	return colorDistance(color1, color2) <= threshold
end

local colorTapScanning = false
local colorTapScanConnection = nil
local colorTapScanThread = nil

local function stopColorTapScan()
	colorTapScanning = false
	if colorTapScanConnection then
		colorTapScanConnection:Disconnect()
		colorTapScanConnection = nil
	end
	if colorTapScanThread then
		task.cancel(colorTapScanThread)
		colorTapScanThread = nil
	end
end

local function startColorTapScan()
	if colorTapScanning then return end
	colorTapScanning = true
	
	local function scan()
		while colorTapScanning and _G.colorTapEnabled do
			task.wait(0.033)
			
			local plus = getColorTapPlus()
			if not plus then continue end
			
			local absPos = plus.AbsolutePosition
			local absSize = plus.AbsoluteSize
			local centerX = absPos.X + absSize.X / 2
			local centerY = absPos.Y + absSize.Y / 2
			local scanPos = Vector2.new(centerX, centerY)
			
			local pixelColor = getPixelColor(scanPos)
			if not pixelColor then continue end
			
			local targetColor = _G.colorTapColor or Color3.fromRGB(0, 255, 0)
			
			if isColorMatch(pixelColor, targetColor, 0.05) then
				if mouse and mouse.Target then
					mouse:Click()
					task.wait(0.05)
					mouse:Click()
				end
			end
		end
	end
	
	colorTapScanThread = task.spawn(scan)
end

local function checkColorTapState()
	if _G.colorTapEnabled then
		if not colorTapScanning then
			startColorTapScan()
		end
	else
		stopColorTapScan()
	end
end

RS.RenderStepped:Connect(function()
	if _G.flying and _G.bodyVelocity and _G.bodyGyro and root then
		local cam = workspace.CurrentCamera
		local move = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move + Vector3.new(0, -1, 0) end
		if move.Magnitude > 0 then move = move.Unit * _G.currentFlight end
		_G.bodyVelocity.Velocity = move
		_G.bodyGyro.CFrame = cam.CFrame
	end

	if _G.aimbotEnabled then
		local targets = getTargets()
		local target = nil
		if _G.targetLockEnabled and _G.lockedTarget and _G.lockedTarget.Character and _G.lockedTarget.Character:FindFirstChild("Head") then
			local d = (_G.lockedTarget.Character.Head.Position - root.Position).Magnitude
			if d <= _G.currentRange then target = _G.lockedTarget else _G.lockedTarget = nil end
		end
		if not target then
			target = selectTarget(targets)
			if _G.targetLockEnabled and target then _G.lockedTarget = target end
		end
		if target and target.Character then
			local aimPart = getAimPart(target)
			if aimPart then
				local d = (aimPart.Position - root.Position).Magnitude
				if d <= _G.currentRange and isVisible(aimPart) then
					local cam = workspace.CurrentCamera
					if _G.aimMode == "Center" then
						local goal = CFrame.new(cam.CFrame.Position, aimPart.Position)
						cam.CFrame = cam.CFrame:Lerp(goal, _G.currentSmoothness)
					else
						local pos, on = cam:WorldToViewportPoint(aimPart.Position)
						if on then
							local mp = UIS:GetMouseLocation()
							mousemoverel((pos.X - mp.X) * _G.currentSmoothness, (pos.Y - mp.Y) * _G.currentSmoothness)
						end
					end
				end
			end
		end
	end
	
	checkColorTapState()
end)

RS.Heartbeat:Connect(function()
	if _G.speedEnabled and _G.currentSpeed > 0 and root and humanoid and not _G.flying then
		local vel = root.AssemblyLinearVelocity
		local moveDir = humanoid.MoveDirection
		local speedMult = _G.currentSpeed / 16
		if moveDir.Magnitude > 0 then
			local currentSpeed = vel.Magnitude
			local targetSpeed = 16 * speedMult
			if currentSpeed < targetSpeed then
				local boost = (targetSpeed - currentSpeed) * 0.3
				local newVel = vel + (moveDir.Unit * boost)
				local newSpeed = newVel.Magnitude
				if newSpeed > targetSpeed then
					newVel = newVel.Unit * targetSpeed
				end
				root.AssemblyLinearVelocity = newVel
			end
		end
	end
	if _G.strafeEnabled and _G.currentStrafe > 0 and root and humanoid and not _G.flying then
		local md = humanoid.MoveDirection
		local sp = humanoid.WalkSpeed
		local des = md * sp
		local vel = root.AssemblyLinearVelocity
		local st = _G.currentStrafe / 100
		root.AssemblyLinearVelocity = Vector3.new(vel.X + (des.X - vel.X) * st, vel.Y, vel.Z + (des.Z - vel.Z) * st)
	end
	if _G.airwalkEnabled and _G.airwalkPlatform and root then
		_G.airwalkPlatform.CFrame = CFrame.new(root.Position.X, _G.airwalkY, root.Position.Z)
	end
end)

player.CharacterAdded:Connect(function(c)
	character = c
	humanoid = character:WaitForChild("Humanoid")
	root = character:WaitForChild("HumanoidRootPart")
	_G.stopFlightFunc()
	_G.stopAirwalkFunc()
	stopColorTapScan()
end)

_G.colorTapEnabledChanged = function()
	checkColorTapState()
end

task.spawn(function()
	while true do
		task.wait(1)
		if _G.colorTapEnabled and not colorTapScanning then
			startColorTapScan()
		end
	end
end)
