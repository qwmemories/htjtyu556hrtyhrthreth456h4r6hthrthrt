local function stroke(parent)
	local s=Instance.new("UIStroke")
	s.Color=Color3.fromRGB(160,160,160)
	s.Transparency=1
	s.Thickness=1.5
	s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
	s.Parent=parent
	return s
end

local function button(parent,size,pos,text)
	local b=Instance.new("TextButton")
	b.Size=size
	b.Position=pos
	b.BackgroundColor3=Color3.new(0.15,0.15,0.15)
	b.BackgroundTransparency=0.04
	b.BorderSizePixel=0
	b.Text=text
	b.TextColor3=Color3.new(0.85,0.85,0.85)
	b.TextSize=13
	b.Font=Enum.Font.GothamBold
	b.AutoButtonColor=false
	b.Parent=parent
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,5)
	local s=stroke(b)
	b.MouseEnter:Connect(function()
		TS:Create(s,TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=0.4}):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(s,TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=1}):Play()
	end)
	return b
end

local function keyText(key)
	if not key then
		return "—"
	end
	local n=key.Name
	local names={
		LeftShift="LShift",
		RightShift="RShift",
		LeftControl="LCtrl",
		RightControl="RCtrl",
		LeftAlt="LAlt",
		RightAlt="RAlt",
		Backspace="Back",
		RightBracket="]",
		LeftBracket="[",
		Semicolon=";",
		Quote="'",
		Comma=",",
		Period=".",
		Slash="/",
		Backquote="`",
		Minus="-",
		Equals="=",
		LeftSuper="LSuper",
		RightSuper="RSuper"
	}
	return names[n] or n
end

local function refreshRow(name)
	local row=bindRows[name]
	if not row then return end
	row.key.Text=keyText(bindings[name])
end

local function cancelCapture()
	if not captureName then return end
	local row=bindRows[captureName]
	if row then
		row.plus.Text="+"
		row.key.Text=keyText(bindings[captureName])
	end
	captureName=nil
	_G.bindCapturing=false
end

local function beginCapture(name)
	if captureName and captureName~=name then
		cancelCapture()
	end
	captureName=name
	_G.bindCapturing=true
	local row=bindRows[name]
	if row then
		row.plus.Text="..."
		row.key.Text="..."
	end
end

local function clearBinding(name)
	if captureName==name then
		captureName=nil
		_G.bindCapturing=false
	end
	bindings[name]=nil
	refreshRow(name)
	if bindRows[name] then
		bindRows[name].plus.Text="+"
	end
end

local function setBinding(name,key)
	for other,current in pairs(bindings) do
		if other~=name and current==key then
			bindings[other]=nil
			refreshRow(other)
		end
	end
	bindings[name]=key
	refreshRow(name)
end

