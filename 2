UIS.InputBegan:Connect(function(input,processed)
	if processed then
		return
	end
	if not captureName then
		local key=input.KeyCode
		if key==Enum.KeyCode.Unknown then
			return
		end
		for name,bound in pairs(bindings) do
			if bound==key then
				local action=actions[name]
				if action then
					pcall(action)
				end
				break
			end
		end
		return
	end

	local key=input.KeyCode
	if key==Enum.KeyCode.Escape then
		cancelCapture()
		return
	end
	if key==Enum.KeyCode.Unknown then
		return
	end

	local name=captureName
	captureName=nil
	_G.bindCapturing=false
	if bindRows[name] then
		bindRows[name].plus.Text="+"
	end
	setBinding(name,key)
end)

setCategoryVisual("movement")
