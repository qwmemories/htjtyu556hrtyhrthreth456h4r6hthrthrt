UIS.InputBegan:Connect(function(input,processed)
	if processed then
		return
	end
	if not captureName then
		local key=input.KeyCode
		if key==Enum.KeyCode.Unknown then
			return
		end
		for name,bound in pairs(bindings) do
			if bound==key then
				local action=actions[name]
				if action then
					pcall(action)
				end
				break
			end
		end
		return
	end

	local key=input.KeyCode
	if key==Enum.KeyCode.Escape then
		cancelCapture()
		return
	end
	if key==Enum.KeyCode.Unknown then
		return
	end

	local name=captureName
	captureName=nil
	_G.keybindCapturing=false
	if keybindRows[name] then
		keybindRows[name].plus.Text="+"
	end
	setBinding(name,key)
end)

local function updateCategoryAfterAction()
	if _G.currentCategory=="keybind" then
		keybindContent.Visible=true
	end
end

for _,name in ipairs(modules) do
	local action=actions[name]
	if action then
		actions[name]=function()
			action()
			updateCategoryAfterAction()
		end
	end
end

