-- main.lua - Главный контроллер
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")
local mouse = player:GetMouse()
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

-- Загрузка модулей
local logic = loadstring(game:HttpGet("https://raw.githubusercontent.com/qwmemories/htjtyu556hrtyhrthreth456h4r6hthrthrt/refs/heads/main/logic.lua"))()
local ui = loadstring(game:HttpGet("https://raw.githubusercontent.com/qwmemories/htjtyu556hrtyhrthreth456h4r6hthrthrt/refs/heads/main/ui.lua"))()

-- Инициализация UI
ui:Init(player, mouse, UIS, RS)

-- Инициализация логики
logic:Init(player, character, humanoid, root, mouse, UIS, RS)

-- Связывание UI и логики
ui:SetLogicCallbacks({
    toggleSpeed = logic.toggleSpeed,
    toggleJump = logic.toggleJump,
    toggleFlight = logic.toggleFlight,
    toggleNoclip = logic.toggleNoclip,
    toggleStrafe = logic.toggleStrafe,
    toggleAirwalk = logic.toggleAirwalk,
    toggleClickTp = logic.toggleClickTp,
    toggleAirJump = logic.toggleAirJump,
    toggleAimbot = logic.toggleAimbot,
    toggleTargetLock = logic.toggleTargetLock,
    toggleWallsCheck = logic.toggleWallsCheck,
    cycleTarget = logic.cycleTarget,
    cycleSort = logic.cycleSort,
    cycleMode = logic.cycleMode,
    applySpeed = logic.applySpeed,
    applyJump = logic.applyJump,
    updateSpeed = logic.updateSpeed,
    updateJump = logic.updateJump,
    updateFlight = logic.updateFlight,
    updateStrafe = logic.updateStrafe,
    updateSmooth = logic.updateSmooth,
    updateRange = logic.updateRange,
    switchCat = ui.switchCat,
    setMinimized = ui.setMinimized
})

-- Запуск
ui:Start()
logic:Start()

-- Обработка смены персонажа
player.CharacterAdded:Connect(function(c)
    logic:OnCharacterAdded(c)
    ui:OnCharacterAdded(c)
end)
