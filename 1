function setColors(en,label,slider,fill,handle)
	local tc=en and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
	local sc=en and Color3.new(0.5,0.5,0.5) or Color3.new(0.3,0.3,0.3)
	local fc=en and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
	local inf=TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	TS:Create(label,inf,{TextColor3=tc}):Play()
	if slider then TS:Create(slider,inf,{BackgroundColor3=sc}):Play() end
	if fill then TS:Create(fill,inf,{BackgroundColor3=fc}):Play() end
	if handle then TS:Create(handle,inf,{BackgroundColor3=fc}):Play() end
end

