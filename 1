    return name.."="..tostring(value)
end

function saveAutoConfig()
    if not G.autoSaveReady or G.scriptTerminated then return false end
    if tick()<G.saveCooldownUntil then return false end
    if type(writefile)~="function" then return false end

    local lines={
        "[AutoSave]", "version=2",
        autoConfigSet("speedEnabled",G.speedEnabled),
        autoConfigSet("jumpEnabled",G.jumpEnabled),
        autoConfigSet("flightEnabled",G.flightEnabled),
        autoConfigSet("noclipEnabled",G.noclipEnabled),
        autoConfigSet("strafeEnabled",G.strafeEnabled),
        autoConfigSet("airwalkEnabled",G.airwalkEnabled),
        autoConfigSet("clickTpEnabled",G.clickTpEnabled),
        autoConfigSet("airJumpEnabled",G.airJumpEnabled),
        autoConfigSet("aimbotEnabled",G.aimbotEnabled),
        autoConfigSet("targetLockEnabled",G.targetLockEnabled),
        autoConfigSet("wallsCheckEnabled",G.wallsCheckEnabled),
        autoConfigSet("aimTarget",G.aimTarget),
        autoConfigSet("aimMode",G.aimMode),
        autoConfigSet("sortMode",G.sortMode),
        autoConfigSet("visualTimerEnabled",G.visualTimerEnabled),
        autoConfigSet("visualTimerValue",G.visualTimerValue),
        autoConfigSet("autoclickerEnabled",G.autoclickerEnabled),
        autoConfigSet("autoclickerCPS",G.autoclickerCPS),
        autoConfigSet("autowalkEnabled",G.autowalkEnabled),
        autoConfigSet("autojumpEnabled",G.autojumpEnabled),
        autoConfigSet("phaseEnabled",G.phaseEnabled),
        autoConfigSet("autoshootEnabled",G.autoshootEnabled),
        autoConfigSet("espEnabled",G.espEnabled),
        autoConfigSet("espFillTransparency",G.espFillTransparency),
        autoConfigSet("espOutlineTransparency",G.espOutlineTransparency),
        autoConfigSet("fullbrightEnabled",G.fullbrightEnabled),
        autoConfigSet("fullbrightBrightness",G.fullbrightBrightness),
        autoConfigSet("nametagEnabled",G.nametagEnabled),
        autoConfigSet("nametagSize",G.nametagSize),
        autoConfigSet("nametagHeight",G.nametagHeight),
        autoConfigSet("nametagAlpha",G.nametagAlpha),
        autoConfigSet("crosshairArrowsEnabled",G.crosshairArrowsEnabled),
        autoConfigSet("crosshairArrowsRadius",G.crosshairArrowsRadius),
        autoConfigSet("crosshairArrowsSize",G.crosshairArrowsSize),
        autoConfigSet("crosshairArrowsAlpha",G.crosshairArrowsAlpha),
        autoConfigSet("currentSpeed",G.currentSpeed),
        autoConfigSet("currentJumpStrength",G.currentJumpStrength),
        autoConfigSet("currentFlight",G.currentFlight),
        autoConfigSet("currentStrafe",G.currentStrafe),
        autoConfigSet("currentSmoothness",G.currentSmoothness),
        autoConfigSet("currentRange",G.currentRange),
        autoConfigSet("hueValue",G.hueValue),
        autoConfigSet("saturationValue",G.saturationValue),
        autoConfigSet("brightnessValue",G.brightnessValue),
        autoConfigSet("hudAlpha",G.hudAlpha),
        autoConfigSet("hudBackgroundBrightness",G.hudBackgroundBrightness),
        "[Binds]"
    }
    for name,key in pairs(binds) do
        if key and key.Name then lines[#lines+1]=name.."="..key.Name end
    end
    local payload=table.concat(lines,"\n").."\n"

    if type(isfolder)=="function" and not isfolder(AUTO_CONFIG_DIR) then
        if type(makefolder)~="function" then return false end
        local made=pcall(makefolder,AUTO_CONFIG_DIR)
        if not made and type(isfolder)=="function" and not isfolder(AUTO_CONFIG_DIR) then return false end
    end

    local ok,err=pcall(function() writefile(AUTO_CONFIG_FILE,payload) end)
    G.autoSaveLastOk=ok
    G.autoSaveLastError=ok and nil or tostring(err)
    G.autoSaveLastTime=tick()
    return ok
end

function autoConfigRead(path)
    if not readfile or not isfile then return nil end
    if not isfile(path) then return nil end
    local ok,data=pcall(readfile,path)
    if ok then return data end
    return nil
end

local function getKeybindEnabled(name)
    local map={
        Speed="speedEnabled", Jump="jumpEnabled", Flight="flightEnabled",
        Strafe="strafeEnabled", Airwalk="airwalkEnabled", ClickTP="clickTpEnabled",
        AirJump="airJumpEnabled", Phase="phaseEnabled", Aimbot="aimbotEnabled",
        VisualTimer="visualTimerEnabled", Autoclicker="autoclickerEnabled",
        AutoWalk="autowalkEnabled", AutoJump="autojumpEnabled", AutoShoot="autoshootEnabled"
    }
    local key=map[name]
    return key and G[key] or false
end

local function syncKeybindVisualState()
    for name,row in pairs(bindRows) do
