-- Keep exactly one permanent RenderStepped worker.
-- It is intentionally NOT created/destroyed by toggle or CharacterAdded, so a
-- death/respawn cannot leave Triggerbot without its worker. The current
-- character reference `c` is refreshed by CharacterAdded below.
if G.triggerbotConnection then
    pcall(function() G.triggerbotConnection:Disconnect() end)
end
G.triggerbotConnection=R.RenderStepped:Connect(function(dt)
    if G.scriptTerminated or not G.triggerbotEnabled then return end
    local valid = triggerbotGetTarget()~=nil
    if G.triggerbotMode=="Hold" then
        if valid and not G.triggerbotHolding then
            G.triggerbotHolding=true
            pcall(mouse1press)
        elseif not valid and G.triggerbotHolding then
            G.triggerbotHolding=false
            pcall(mouse1release)
        end
        return
    end
    if not valid then return end
    G.triggerbotAccumulator=G.triggerbotAccumulator+math.min(dt,0.1)
    if G.triggerbotAccumulator<0.025 then return end
    G.triggerbotAccumulator=G.triggerbotAccumulator-0.025
    pcall(mouse1click)
end)

