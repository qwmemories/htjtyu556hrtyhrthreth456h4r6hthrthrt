R.Heartbeat:Connect(function()
    if G.scriptTerminated then return end

    if G.speedEnabled and G.currentSpeed>0 and r and h and not G.flying then
        local vel=r.AssemblyLinearVelocity
        local moveDir=h.MoveDirection
        local speedMult=G.currentSpeed/16
        if moveDir.Magnitude>0 then
            local currentSpeed=vel.Magnitude
            local targetSpeed=16*speedMult
            if currentSpeed<targetSpeed then
                local boost=(targetSpeed-currentSpeed)*0.3
                local newVel=vel+(moveDir.Unit*boost)
                local newSpeed=newVel.Magnitude
                if newSpeed>targetSpeed then
                    newVel=newVel.Unit*targetSpeed
                end
                r.AssemblyLinearVelocity=newVel
            end
        end
    end

    if G.strafeEnabled and G.currentStrafe>0 and r and h and not G.flying then
        local md=h.MoveDirection
        local sp=h.WalkSpeed
        local des=md*sp
        local vel=r.AssemblyLinearVelocity
        local st=G.currentStrafe/100
        r.AssemblyLinearVelocity=Vector3.new(
            vel.X+(des.X-vel.X)*st,
            vel.Y,
            vel.Z+(des.Z-vel.Z)*st
        )
    end

    if G.airwalkEnabled and G.airwalkPlatform and r then
        G.airwalkPlatform.CFrame=CFrame.new(r.Position.X,G.airwalkY,r.Position.Z)
    end
end)

R.RenderStepped:Connect(function(dt)
    if G.scriptTerminated then return end

    if G.flying and G.bodyVelocity and G.bodyGyro and r then
        local cam=workspace.CurrentCamera
        local move=Vector3.zero
        if U:IsKeyDown(Enum.KeyCode.W) then move=move+cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.S) then move=move-cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.A) then move=move-cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.D) then move=move+cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.Space) then move=move+Vector3.new(0,1,0) end
        if U:IsKeyDown(Enum.KeyCode.LeftControl) then move=move+Vector3.new(0,-1,0) end
        if move.Magnitude>0 then move=move.Unit*G.currentFlight end
        G.bodyVelocity.Velocity=move
        G.bodyGyro.CFrame=cam.CFrame
    end

    if G.aimbotEnabled then
        local targets={}
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=p and plr.Character then
                local hum=plr.Character:FindFirstChildOfClass("Humanoid")
                local root=plr.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health>0 and root then
                    table.insert(targets,{type="player",plr=plr,char=plr.Character,root=root,hum=hum})
                end
            end
        end

        for _,model in ipairs(WS:GetChildren()) do
            if model:IsA("Model") and model~=c then
                local hum=model:FindFirstChildOfClass("Humanoid")
                local root=model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                if hum and hum.Health>0 and root and not P:GetPlayerFromCharacter(model) then
                    table.insert(targets,{type="npc",model=model,hum=hum,root=root})
                end
            end
        end

        local cam=workspace.CurrentCamera
        local target=nil
        if cam then
            if G.targetLockEnabled and G.lockedTarget then
                local lt=G.lockedTarget
                local valid=(lt.type=="player" and lt.plr and lt.plr.Character==lt.char)
                    or (lt.type=="npc" and lt.model and lt.model.Parent)
                if valid and lt.root and (lt.root.Position-r.Position).Magnitude<=G.currentRange then
                    target=lt
                else
                    G.lockedTarget=nil
                end
            end

            if not target and #targets>0 then
                if G.sortMode=="Distance" then
                    table.sort(targets,function(a,b)
                        return (a.root.Position-r.Position).Magnitude < (b.root.Position-r.Position).Magnitude
                    end)
                else
                    local mp=U:GetMouseLocation()
                    table.sort(targets,function(a,b)
                        local paPart=(a.char and a.char:FindFirstChild("Head"))
                            or (a.model and a.model:FindFirstChild("Head")) or a.root
                        local pbPart=(b.char and b.char:FindFirstChild("Head"))
                            or (b.model and b.model:FindFirstChild("Head")) or b.root
                        local pa,oa=cam:WorldToViewportPoint(paPart.Position)
                        local pb,ob=cam:WorldToViewportPoint(pbPart.Position)
                        if not oa then return false end
                        if not ob then return true end
                        local mpv=Vector2.new(mp.X,mp.Y)
                        return (Vector2.new(pa.X,pa.Y)-mpv).Magnitude
                            < (Vector2.new(pb.X,pb.Y)-mpv).Magnitude
                    end)
                end
                target=targets[1]
                if G.targetLockEnabled then G.lockedTarget=target end
            end

            if target then
                local aimPart
                if G.aimTarget=="Head" then
                    aimPart=(target.char and target.char:FindFirstChild("Head"))
                        or (target.model and target.model:FindFirstChild("Head"))
                else
                    aimPart=target.root
                end

                if aimPart and (aimPart.Position-r.Position).Magnitude<=G.currentRange then
                    local visible=true
                    if G.wallsCheckEnabled then
                        local params=RaycastParams.new()
                        params.FilterType=Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances={c}
                        params.IgnoreWater=true
                        local origin=cam.CFrame.Position
                        local hit=workspace:Raycast(origin,aimPart.Position-origin,params)
                        visible=hit and hit.Instance and hit.Instance:IsDescendantOf(aimPart.Parent) or false
                    end

                    if visible then
                        local alpha=math.clamp(G.currentSmoothness,0.01,1)
                        if G.aimMode=="Cursor" then
                            local pos,on=cam:WorldToViewportPoint(aimPart.Position)
                            if on then
                                local mp=U:GetMouseLocation()
                                local dx=pos.X-mp.X
                                local dy=pos.Y-mp.Y
                                if math.abs(dx)>0.35 or math.abs(dy)>0.35 then
                                    pcall(function() mousemoverel(dx*alpha,dy*alpha) end)
                                end
                            end
                        else
                            cam.CFrame=cam.CFrame:Lerp(
                                CFrame.new(cam.CFrame.Position,aimPart.Position),
                                alpha
                            )
                        end
                    end
                end
            end
        end
    end
end)

