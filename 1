function hover(b,s)
    b.MouseEnter:Connect(function()
        s.Color=hudWhite()
        T:Create(s,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
            Transparency=0.5,
            Color=hudWhite()
        }):Play()
    end)
    b.MouseLeave:Connect(function()
        T:Create(s,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=1}):Play()
    end)
end
