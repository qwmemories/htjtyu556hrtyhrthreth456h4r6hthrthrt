function startFps()
    if G.fpsConnection then return end
    local f=0
    local l=tick()
    G.fpsConnection=R.RenderStepped:Connect(function()
        if G.scriptTerminated then return end
        f=f+1
        local n=tick()
        if n-l>=0.016 then
            fpsLabel.Text="fps "..math.floor(f/(n-l))
            f=0
            l=n
        end
    end)
end

function setMinimized(s)
    if G.isAnimating then return end
    G.isAnimating=true
    G.isHidden=s
    scrollTrack.Visible=false
    scrollThumb.Visible=false
    cv.ScrollingEnabled=false
    local ts=s and UDim2.new(0,435,0,30) or UDim2.new(0,435,0,500)
    local tw=T:Create(mf,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=ts})
    if s then
        setVisible(false)
        startFps()
        T:Create(fpsLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=0}):Play()
        T:Create(versionLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=1}):Play()
    else
        T:Create(fpsLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=1}):Play()
        T:Create(versionLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=0}):Play()
    end
    tw:Play()
    tw.Completed:Connect(function()
        if not s then
            setVisible(true)
            rs(true)
        else
            scrollTrack.Visible=false
            scrollThumb.Visible=false
        end
        G.isAnimating=false
    end)
end

