mf.InputBegan:Connect(function(i)
	if _G.isSliding then return end
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		_G.isDragging=true
		_G.dragStart=i.Position
		_G.startPos=mf.Position
		_G.targetPos=mf.Position
	end
end)

UIS.InputChanged:Connect(function(i)
	if _G.isDragging and not _G.isSliding and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		local d=i.Position-_G.dragStart
		_G.targetPos=UDim2.new(_G.startPos.X.Scale,_G.startPos.X.Offset+d.X,_G.startPos.Y.Scale,_G.startPos.Y.Offset+d.Y)
	end
end)

UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		_G.isDragging=false
		_G.isSliding=false
	end
end)

RS.RenderStepped:Connect(function()
	if _G.targetPos then
		local c=mf.Position
		local dx=_G.targetPos.X.Offset-c.X.Offset
		local dy=_G.targetPos.Y.Offset-c.Y.Offset
		if math.abs(dx)>0.5 or math.abs(dy)>0.5 then
			mf.Position=UDim2.new(c.X.Scale,c.X.Offset+dx*0.18,c.Y.Scale,c.Y.Offset+dy*0.18)
		end
	end
end)

local function setVisible(s)
	mc.Visible=s and _G.currentCategory=="movement"
	miscC.Visible=s and _G.currentCategory=="misc"
	catBar.Visible=s
end

local function startFps()
	if _G.fpsConnection then return end
	local f=0
	local l=tick()
	_G.fpsConnection=RS.RenderStepped:Connect(function()
		f=f+1
		local n=tick()
		if n-l>=0.016 then
			fpsLabel.Text="fps "..math.floor(f/(n-l))
			f=0
			l=n
		end
	end)
end

local function setMinimized(s)
	if _G.isAnimating then return end
	_G.isAnimating=true
	_G.isHidden=s
	local ts=s and UDim2.new(0,320,0,30) or UDim2.new(0,320,0,480)
	local tw=TS:Create(mf,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=ts})
	if s then
		setVisible(false)
		startFps()
		TS:Create(fpsLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=0}):Play()
	else
		TS:Create(fpsLabel,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=1}):Play()
	end
	tw:Play()
	tw.Completed:Connect(function()
		if not s then
			setVisible(true)
			if _G.fpsConnection then _G.fpsConnection:Disconnect() _G.fpsConnection=nil end
		end
		_G.isAnimating=false
	end)
end

hideBtn.MouseButton1Click:Connect(function() setMinimized(not _G.isHidden) end)

closeBtn.MouseButton1Click:Connect(function()
	stopFlight()
	stopAirwalk()
	if _G.fpsConnection then _G.fpsConnection:Disconnect() end
	if _G.noclipConnection then _G.noclipConnection:Disconnect() end
	mouse.Icon=""
	sg:Destroy()
end)

