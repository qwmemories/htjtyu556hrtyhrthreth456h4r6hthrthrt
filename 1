        if not made and type(isfolder)=="function" and not isfolder(AUTO_CONFIG_DIR) then return false end
    end

    local ok,err=pcall(function() writefile(AUTO_CONFIG_FILE,payload) end)
    G.autoSaveLastOk=ok
    G.autoSaveLastError=ok and nil or tostring(err)
