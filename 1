        if not G.autoshootConnection then
            G.autoshootConnection=R.RenderStepped:Connect(function()
                if not G.autoshootEnabled then return end
                if G.autoshootCooldown and tick()<G.autoshootCooldownEnd then return end
                local duel=workspace:FindFirstChild("Duel")
                if not duel then return end
                local light=duel:FindFirstChild("Light")
                if not light then return end
                local currentColor=light.Color
                local targetR,targetG,targetB=40/255,127/255,71/255
                local isTargetColor=math.abs(currentColor.r-targetR)<0.05 and math.abs(currentColor.g-targetG)<0.05 and math.abs(currentColor.b-targetB)<0.05
                if isTargetColor and not G.autoshootLastColor then
                    doThreeClicks()
                    G.autoshootCooldown=true
                    G.autoshootCooldownEnd=tick()+20
                end
                G.autoshootLastColor=isTargetColor
            end)
        end
    else
        if G.autoshootConnection then
            G.autoshootConnection:Disconnect()
            G.autoshootConnection=nil
        end
        G.autoshootLastColor=nil
        G.autoshootCooldown=false
