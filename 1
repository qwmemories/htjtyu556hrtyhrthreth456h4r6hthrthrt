    if char then
        for _,obj in ipairs(char:GetDescendants()) do
            if obj.Name=="CustomNametag" and obj:IsA("BillboardGui") then
                obj:Destroy()
            end
        end

        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            if saved and saved.character==char and saved.displayDistanceType then
                hum.DisplayDistanceType=saved.displayDistanceType
                if saved.displayName~=nil then hum.DisplayName=saved.displayName end
            else
                hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer
            end
        end
    end

    G.nametagHumanoids[plr]=nil
end

function applyNametagToPlayer(plr)
    if not G.nametagEnabled or plr==p then return end
    local char=plr.Character
    if not char then return end

    local hum=char:FindFirstChildOfClass("Humanoid")
    local head=char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not hum or not head then return end

    local saved=G.nametagHumanoids[plr]
    if not saved or saved.character~=char then
        G.nametagHumanoids[plr]={
            character=char,
            displayDistanceType=hum.DisplayDistanceType,
            displayName=hum.DisplayName
        }
    end

    hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    hum:GetPropertyChangedSignal("DisplayName"):Connect(function()
        if G.nametagEnabled then
            hum.DisplayName=""
        end
    end)

    local tag=head:FindFirstChild("CustomNametag")
    if not tag or not tag:IsA("BillboardGui") then
        if tag then tag:Destroy() end
        tag=Instance.new("BillboardGui")
        tag.Name="CustomNametag"
        tag.Adornee=head
        tag.AlwaysOnTop=true
        tag.LightInfluence=0
        tag.MaxDistance=1000
