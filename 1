function setToggle(t,k,on,anim)
	local pos=on and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
	local tc=on and Color3.new(0.5,0.5,0.5) or Color3.new(0.15,0.15,0.15)
	local kc=on and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
	if anim then
		local inf=TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
		TS:Create(k,inf,{Position=pos,BackgroundColor3=kc}):Play()
		TS:Create(t,inf,{BackgroundColor3=tc}):Play()
	else
		k.Position=pos
		k.BackgroundColor3=kc
		t.BackgroundColor3=tc
	end
end

function hover(b,s)
	b.MouseEnter:Connect(function()
		TS:Create(s,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=0.4}):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(s,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=1}):Play()
	end)
end

