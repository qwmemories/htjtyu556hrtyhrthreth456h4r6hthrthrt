function loadAutoConfig()
    if autoConfigLoading then return end
    local data=autoConfigRead(AUTO_CONFIG_FILE)
    if not data then return end
    autoConfigLoading=true
    local values={}
    local section=""
    for line in string.gmatch(data,"[^\r\n]+") do
        if line=="[AutoSave]" or line=="[Binds]" then
            section=line
        else
            local k,v=line:match("^([^=]+)=(.*)$")
            if k and v then
                values[section..k]=v
            end
        end
    end

    local function num(key,default)
        local v=tonumber(values["[AutoSave]"..key])
        return v~=nil and v or default
    end
    local function bool(key,default)
        local v=values["[AutoSave]"..key]
        return v~=nil and autoConfigBool(v) or default
    end

    updateSpeed((num("currentSpeed",G.currentSpeed)-G.minSpeed)/(G.maxSpeed-G.minSpeed))
    updateJump((num("currentJumpStrength",G.currentJumpStrength)-G.minJump)/(G.maxJump-G.minJump))
    updateFlight((num("currentFlight",G.currentFlight)-G.minFlight)/(G.maxFlight-G.minFlight))
    updateStrafe((num("currentStrafe",G.currentStrafe)-G.minStrafe)/(G.maxStrafe-G.minStrafe))
    updateSmooth((num("currentSmoothness",G.currentSmoothness)-G.minSmooth)/(G.maxSmooth-G.minSmooth))
    updateRange((num("currentRange",G.currentRange)-G.minRange)/(G.maxRange-G.minRange))
    updateVisualTimer(num("visualTimerValue",G.visualTimerValue)/G.maxVisualTimer)
    updateAutoclickerCPS((num("autoclickerCPS",G.autoclickerCPS)-G.minCPS)/(G.maxCPS-G.minCPS))
    updateESPFill(num("espFillTransparency",G.espFillTransparency))
    updateESPOutline(num("espOutlineTransparency",G.espOutlineTransparency))
    G.boxEspAlpha=num("boxEspAlpha",G.boxEspAlpha)
    G.tracersAlpha=num("tracersAlpha",G.tracersAlpha)
    G.updateBoxEspAlpha(G.boxEspAlpha)
    G.updateTracersAlpha(G.tracersAlpha)
    if G.boxUI and G.boxUI.alpha then G.boxUI.alpha.setActive(G.boxEspEnabled,false) end
    if G.tracerUI and G.tracerUI.alpha then G.tracerUI.alpha.setActive(G.tracersEnabled,false) end
    updateNametagSize((num("nametagSize",G.nametagSize)-10)/(28-10))
    updateNametagHeight((num("nametagHeight",G.nametagHeight)+2)/10)
    updateNametagAlpha(num("nametagAlpha",G.nametagAlpha))
    
    updateFullbrightBrightness(num("fullbrightBrightness",G.fullbrightBrightness))
    updateCrosshairRadius((num("crosshairArrowsRadius",G.crosshairArrowsRadius)-20)/(300-20))
    updateCrosshairSize((num("crosshairArrowsSize",G.crosshairArrowsSize)-25)/(100-25))
    updateCrosshairAlpha(num("crosshairArrowsAlpha",G.crosshairArrowsAlpha))

    G.visualTimerValue=num("visualTimerValue",G.visualTimerValue)
    G.aimTarget=values["[AutoSave]aimTarget"] or G.aimTarget
    G.aimMode=values["[AutoSave]aimMode"] or G.aimMode
    G.sortMode=values["[AutoSave]sortMode"] or G.sortMode
    G.triggerbotEnabled=bool("triggerbotEnabled",G.triggerbotEnabled)
    G.triggerbotTarget=values["[AutoSave]triggerbotTarget"] or G.triggerbotTarget
    G.triggerbotMode=values["[AutoSave]triggerbotMode"] or G.triggerbotMode
    if tbModeB then tbModeB.Text=G.triggerbotMode end
    G.espNPCMode=values["[AutoSave]espNPCMode"] or G.espNPCMode
    G.autoLoadEnabled=bool("autoLoadEnabled",G.autoLoadEnabled)
    -- nametagHealthEnabled не загружаем

    targB.Text=G.aimTarget
    sortB.Text=G.sortMode
    modeB.Text=G.aimMode
    tbTargetB.Text=G.triggerbotTarget
    
    local npcOptions={"All","Players","NPC"}
    for i,v in ipairs(npcOptions) do
        if v==G.espNPCMode then
            espUI.npc.setIndex(i)
            break
        end
    end

    local savedRgbEnabled=bool("rgbEnabled",G.rgbEnabled)
    updateHue(num("hueValue",G.hueValue))
    updateSaturation(num("saturationValue",G.saturationValue))
    updateBrightness(num("brightnessValue",G.brightnessValue))
    updateRgbSpeed((num("rgbSpeed",G.rgbSpeed)-0.05)/(3-0.05))
    updateRgbBrightness(num("rgbBrightness",G.rgbBrightness))
    if savedRgbEnabled~=G.rgbEnabled then
        toggleRGB()
    end
    updateHudAlpha((num("hudAlpha",G.hudAlpha)-0.2)/(1-0.2))
    updateHudBackgroundBrightness(num("hudBackgroundBrightness",G.hudBackgroundBrightness)/0.5)

    local toggleMap={
        speedEnabled=toggleSpeed,jumpEnabled=toggleJump,flightEnabled=toggleFlight,
        noclipEnabled=toggleNoclip,strafeEnabled=toggleStrafe,airwalkEnabled=toggleAirwalk,
        clickTpEnabled=toggleClickTp,airJumpEnabled=toggleAirJump,aimbotEnabled=toggleAimbot,
        targetLockEnabled=toggleTargetLock,wallsCheckEnabled=toggleWallsCheck,
        visualTimerEnabled=toggleVisualTimer,autoclickerEnabled=toggleAutoclicker,
        autowalkEnabled=toggleAutoWalk,autojumpEnabled=toggleAutoJump,
        phaseEnabled=togglePhase,autoshootEnabled=toggleAutoShoot,triggerbotEnabled=toggleTriggerbot,
        espEnabled=toggleESP,boxEspEnabled=function() G.boxEspEnabled=not G.boxEspEnabled end,
        tracersEnabled=function() G.tracersEnabled=not G.tracersEnabled end,fullbrightEnabled=toggleFullbright,
        nametagEnabled=toggleNametags, -- healthToggle удален
        crosshairArrowsEnabled=toggleCrosshairArrows
    }
    for key,fn in pairs(toggleMap) do
        if bool(key,false) then
            local current=G[key]
            if not current then fn() end
        end
    end

    syncAllModuleVisualState()
    applyHudTheme(true)
    keepHudPickerBright()

    for name,keyName in pairs(values) do
        local bindName=name:match("^%[Binds%](.+)$")
        if bindName and bindRows[bindName] then
            local kc=Enum.KeyCode[keyName]
            if kc then
                binds[bindName]=kc
                bindRows[bindName].bind.Text=kc.Name
            end
        end
    end
    syncKeybindVisualState()
    for _,row in pairs(bindRows) do
        if row and row.stroke then
            row.stroke.Color=hudWhite()
            row.stroke.Transparency=1
        end
    end

    autoConfigLoading=false
end

function getQueueOnTeleport()
    if type(queueteleport)=="function" then return queueteleport end
    if type(queue_on_teleport)=="function" then return queue_on_teleport end
    if type(syn)=="table" and type(syn.queue_on_teleport)=="function" then return syn.queue_on_teleport end
    if type(fluxus)=="table" and type(fluxus.queue_on_teleport)=="function" then return fluxus.queue_on_teleport end
    local x=rawget(_G,"Xeno")
    if type(x)=="table" and type(x.queue_on_teleport)=="function" then return x.queue_on_teleport end
    if type(shared)=="table" and type(shared.Xeno)=="table" and type(shared.Xeno.queue_on_teleport)=="function" then
        return shared.Xeno.queue_on_teleport
    end
    return nil
end

function queueAutoLoad()
    if not G.autoLoadEnabled or G.scriptTerminated then return false end
    local q=getQueueOnTeleport()
    if not q then return false end

    local url=tostring(G.autoLoadURL or "")
    if url=="" then return false end

    -- The queued source is deliberately small: after the new Place loads,
    -- fetch the current GitHub Raw script and execute it. The freshly
    -- executed copy installs the queue again, so the chain survives
    -- subsequent PlaceId changes as long as the executor remains attached.
    local queued="loadstring(game:HttpGet("..string.format("%q",url).."))()"

    local ok=false
    local ok2,res=pcall(q,"s",queued)
    if ok2 and res~=false then
        ok=true
    else
        local ok3,res3=pcall(q,queued)
        ok=ok3 and res3~=false
    end
    G.autoLoadQueued=ok
    return ok
end

p.OnTeleport:Connect(function(state)
    if not G.autoLoadEnabled or G.scriptTerminated then return end
    if state==Enum.TeleportState.Started then
        queueAutoLoad()
    end
end)

