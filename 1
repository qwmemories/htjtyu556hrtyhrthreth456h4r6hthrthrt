G.getVisualEspDrawing=function(plr,kind)
    local cache=(kind=="box" and G.boxEspDrawings or G.tracerDrawings)
    if cache[plr] then return cache[plr] end
    if not Drawing or type(Drawing.new)~="function" then return nil end
    local ok,obj=pcall(function()
        return Drawing.new(kind=="box" and "Square" or "Line")
    end)
    if not ok or not obj then return nil end
    pcall(function() obj.Visible=false end)
    pcall(function() obj.Color=hudWhite() end)
    pcall(function() obj.Transparency=1 end)
    pcall(function() obj.Thickness=1.5 end)
    if kind=="box" then pcall(function() obj.Filled=false end) end
    cache[plr]=obj
    return obj
end

