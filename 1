G.restoreForeignHighlights=function()
    for obj,enabled in pairs(G.espSuppressedHighlights) do
        if obj and obj.Parent then
            pcall(function() obj.Enabled=enabled end)
        end
    end
    for obj,conn in pairs(G.espForeignConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    G.espSuppressedHighlights={}
    G.espForeignConnections={}
end

local function trackForeignHighlight(obj)
    if not obj or not obj:IsA("Highlight") or not G.espEnabled then return end
    if G.espForeignConnections[obj] then return end
    local model=obj:FindFirstAncestorOfClass("Model")
    if not model or model==c then return end
    local own=model:FindFirstChild("Totally NOT Esp")
    if own==obj then return end

    if G.espSuppressedHighlights[obj]==nil then
        G.espSuppressedHighlights[obj]=obj.Enabled
    end
    pcall(function() obj.Enabled=false end)

    G.espForeignConnections[obj]=obj:GetPropertyChangedSignal("Enabled"):Connect(function()
        if G.espEnabled and obj.Parent then
            pcall(function() obj.Enabled=false end)
        end
    end)

    obj.AncestryChanged:Connect(function(_,parent)
        if parent then return end
        local conn=G.espForeignConnections[obj]
        if conn then pcall(function() conn:Disconnect() end) end
        G.espForeignConnections[obj]=nil
        G.espSuppressedHighlights[obj]=nil
    end)
end

G.suppressForeignHighlights=function(model,own)
    if not G.espEnabled or not model or not model.Parent then return end
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("Highlight") and obj~=own then
            trackForeignHighlight(obj)
        end
    end
end

function clearESP()
    G.restoreForeignHighlights()
    for model,conn in pairs(G.espTrackedModels) do
        if conn then pcall(function() conn:Disconnect() end) end
        G.espTrackedModels[model]=nil
    end
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=p then
            local char=plr.Character
            if char then
                local esp=char:FindFirstChild("Totally NOT Esp")
                if esp and esp:IsA("Highlight") then esp:Destroy() end
            end
        end
    end
    for _,model in ipairs(WS:GetChildren()) do
        if model:IsA("Model") and model~=c then
            local esp=model:FindFirstChild("Totally NOT Esp")
            if esp and esp:IsA("Highlight") then esp:Destroy() end
        end
    end
end

function shouldESPApply(model)
    if not G.espEnabled or model==c then return false end
    if G.espNPCMode=="All" then return true end
    local plr=P:GetPlayerFromCharacter(model)
    if G.espNPCMode=="Players" then return plr~=nil and plr~=p end
    if G.espNPCMode=="NPC" then return plr==nil end
    return true
end

function applyESPToModel(model)
    if not G.espEnabled or model==c or not model:IsA("Model") then return end
    local hum=model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 or not shouldESPApply(model) then return end

    G.espTrackedModels[model]=G.espTrackedModels[model] or model.AncestryChanged:Connect(function(_,parent)
        if not parent then
            local conn=G.espTrackedModels[model]
            if conn then pcall(function() conn:Disconnect() end) end
            G.espTrackedModels[model]=nil
        end
    end)

    local esp=model:FindFirstChild("Totally NOT Esp")
    if not esp or not esp:IsA("Highlight") then
        esp=Instance.new("Highlight")
        esp.Name="Totally NOT Esp"
        esp.Adornee=model
        esp.Archivable=true
        esp.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        esp.Parent=model
        registerHudThemeObject(esp)
    end

    G.suppressForeignHighlights(model,esp)
    esp.Enabled=true
    esp.FillColor=hudWhite()
    esp.OutlineColor=hudWhite()
    esp.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    esp.FillTransparency=1-math.clamp(G.espFillTransparency,0,1)
    esp.OutlineTransparency=1-math.clamp(G.espOutlineTransparency,0,1)
end

function refreshESP()
    if not G.espEnabled then clearESP(); return end

    -- Player characters are the common ESP target. Handle them directly so
    -- refreshes do not have to walk unrelated Workspace objects.
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=p and plr.Character then
            applyESPToModel(plr.Character)
        end
    end

    -- Keep NPC support, but only inspect top-level models (the old behavior).
    if G.espNPCMode~="Players" then
        for _,model in ipairs(WS:GetChildren()) do
            if model:IsA("Model") and model~=c and P:GetPlayerFromCharacter(model)==nil then
                applyESPToModel(model)
            end
        end
    end
end

WS.ChildAdded:Connect(function(model)
    if not model:IsA("Model") or model==c then return end
    task.defer(function()
        if G.espEnabled then applyESPToModel(model) end
    end)
end)

WS.DescendantAdded:Connect(function(obj)
    if not G.espEnabled then return end
    if obj:IsA("Highlight") then
        local model=obj:FindFirstAncestorOfClass("Model")
        if model and model~=c then
            trackForeignHighlight(obj)
            task.defer(function()
                if G.espEnabled then applyESPToModel(model) end
            end)
        end
    elseif obj:IsA("Humanoid") then
        local model=obj.Parent
        if model and model:IsA("Model") and model~=c then
            task.defer(function()
                if G.espEnabled then applyESPToModel(model) end
            end)
        end
    end
end)

G.hookESPPlayer=function(plr)
    if plr==p then return end

    plr.CharacterAdded:Connect(function(char)
        -- Apply as soon as the Humanoid exists, then retry after appearance
        -- loading. This fixes games that assemble characters in several steps.
        task.spawn(function()
            local hum=char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid",5)
            if hum and G.espEnabled then applyESPToModel(char) end
        end)

        pcall(function()
            plr.CharacterAppearanceLoaded:Connect(function(loadedChar)
                if G.espEnabled and loadedChar==plr.Character then
                    applyESPToModel(loadedChar)
                end
            end)
        end)
    end)

    if plr.Character then
        task.defer(function()
            if G.espEnabled then applyESPToModel(plr.Character) end
        end)
    end
end

