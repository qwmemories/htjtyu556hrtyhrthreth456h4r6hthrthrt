mf.InputBegan:Connect(function(i)
    if G.isSliding then return end
    if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end

    local pos=i.Position
    local function inside(gui)
        if not gui or not gui.Parent then return false end
        local ap,as=gui.AbsolutePosition,gui.AbsoluteSize
        return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
    end

    -- Slider input must never fall through to the window drag handler.
    if inside(espFillS) or inside(espFillH) or
       inside(espOutlineS) or inside(espOutlineH) or
       inside(nametagSizeS) or inside(nametagSizeH) or
       inside(nametagHeightS) or inside(nametagHeightH) or
       inside(nametagAlphaS) or inside(nametagAlphaH) or
       inside(crosshairRadiusS) or inside(crosshairRadiusH) or
       inside(crosshairSizeS) or inside(crosshairSizeH) or
       inside(crosshairAlphaS) or inside(crosshairAlphaH) or
       inside(fullbrightBrightnessS) or inside(fullbrightBrightnessH) or
       inside(vtMiscS) or inside(vtMiscH) or
       inside(acS) or inside(acH) or
       (G.boxUI and G.boxUI.alpha and (inside(G.boxUI.alpha.s) or inside(G.boxUI.alpha.h))) or
       (G.tracerUI and G.tracerUI.alpha and (inside(G.tracerUI.alpha.s) or inside(G.tracerUI.alpha.h))) then
        G.isSliding=true
        return
    end

    G.isDragging=true
    G.dragStart=i.Position
    G.startPos=mf.Position
    G.targetPos=mf.Position
end)

