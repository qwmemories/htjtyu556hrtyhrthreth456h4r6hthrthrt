-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =====
local function createToggle(parent, position)
	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 46, 0, 22)
	track.Position = position
	track.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
	track.BackgroundTransparency = 0.04
	track.BorderSizePixel = 0
	track.Parent = parent
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local trackStroke = Instance.new("UIStroke")
	trackStroke.Color = Color3.fromRGB(160, 160, 160)
	trackStroke.Transparency = 1
	trackStroke.Thickness = 1.5
	trackStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	trackStroke.Parent = track

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 2, 0.5, -9)
	knob.BackgroundColor3 = Color3.new(0.6, 0.6, 0.6)
	knob.BorderSizePixel = 0
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local clickButton = Instance.new("TextButton")
	clickButton.Size = UDim2.new(1, 0, 1, 0)
	clickButton.BackgroundTransparency = 1
	clickButton.Text = ""
	clickButton.Parent = track

	return track, knob, trackStroke, clickButton
end

local function addSliderStroke(slider, handle)
	local sStroke = Instance.new("UIStroke")
	sStroke.Color = Color3.fromRGB(160, 160, 160)
	sStroke.Transparency = 1
	sStroke.Thickness = 1.5
	sStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	sStroke.Parent = slider

	local hStroke = Instance.new("UIStroke")
	hStroke.Color = Color3.fromRGB(160, 160, 160)
	hStroke.Transparency = 1
	hStroke.Thickness = 1.5
	hStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	hStroke.Parent = handle

	return sStroke, hStroke
end

