local function updateSpeed(value)
	_G.currentSpeed = _G.minSpeed + (_G.maxSpeed - _G.minSpeed) * value
	speedText.Text = "Speed: " .. math.floor(_G.currentSpeed + 0.5)
	if _G.speedEnabled and humanoid then humanoid.WalkSpeed = _G.currentSpeed end
end

local function updateJump(value)
	_G.currentJump = _G.minJump + (_G.maxJump - _G.minJump) * value
	jumpText.Text = "Jump: " .. math.floor(_G.currentJump + 0.5)
	if _G.jumpEnabled and humanoid then humanoid.JumpPower = _G.currentJump end
end

local function updateFlight(value)
	_G.currentFlight = _G.minFlight + (_G.maxFlight - _G.minFlight) * value
	flightText.Text = "Flight: " .. math.floor(_G.currentFlight + 0.5)
end

local function updateStrafe(value)
	_G.currentStrafe = _G.minStrafe + (_G.maxStrafe - _G.minStrafe) * value
	strafeText.Text = "Strafe: " .. math.floor(_G.currentStrafe + 0.5)
end

local function updateSmooth(value)
	_G.currentSmoothness = _G.minSmooth + (_G.maxSmooth - _G.minSmooth) * value
	smoothText.Text = "Speed: " .. string.format("%.2f", _G.currentSmoothness)
end

local function updateRange(value)
	_G.currentRange = _G.minRange + (_G.maxRange - _G.minRange) * value
	rangeText.Text = "Range: " .. math.floor(_G.currentRange + 0.5)
end

local function updateSpeedFromInput(input)
	local size = speedSlider.AbsoluteSize.X
	if size <= 0 then return end
	local value = math.clamp(input.Position.X - speedSlider.AbsolutePosition.X, 0, size) / size
	updateSliderPosition(speedFill, speedHandle, value)
	updateSpeed(value)
end

local function updateJumpFromInput(input)
	local size = jumpSlider.AbsoluteSize.X
	if size <= 0 then return end
	local value = math.clamp(input.Position.X - jumpSlider.AbsolutePosition.X, 0, size) / size
	updateSliderPosition(jumpFill, jumpHandle, value)
	updateJump(value)
end

