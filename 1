        if tag then tag:Destroy() end
        tag=Instance.new("BillboardGui")
        tag.Name="CustomNametag"
        tag.Adornee=head
        tag.AlwaysOnTop=true
        tag.LightInfluence=0
        tag.MaxDistance=1000
        tag.Size=UDim2.fromOffset(220,50)
        tag.Parent=head

