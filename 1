local function updateHudBackground()
    local alpha=math.clamp(G.hudAlpha,0.2,1)
    local strength=math.clamp(G.hudBackgroundBrightness/0.5,0,0.2)

    local bg=Color3.new(
        G.hudColor.R*strength,
        G.hudColor.G*strength,
        G.hudColor.B*strength
    )

    mf.BackgroundColor3=bg
    mf.BackgroundTransparency=1-alpha

    local buttonStrength=math.clamp(strength*0.75,0,0.15)
    local buttonColor=Color3.new(
        G.hudColor.R*buttonStrength,
        G.hudColor.G*buttonStrength,
        G.hudColor.B*buttonStrength
    )

    hideBtn.BackgroundColor3=buttonColor
    closeBtn.BackgroundColor3=buttonColor
    hideBtn.BackgroundTransparency=1-alpha
    closeBtn.BackgroundTransparency=1-alpha
end

local function makeHudBackgroundSlider(y,labelText,initial01,kind)
    local label=Instance.new("TextLabel")
    label.Size=UDim2.new(0.5,0,0,22)
    label.Position=UDim2.new(0,5,0,y)
    label.BackgroundTransparency=1
    label.Text=labelText
    label.TextColor3=hudWhite()
    label.TextSize=16
    label.Font=Enum.Font.Gotham
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.Parent=hudC

    local s=Instance.new("Frame")
    s.Size=UDim2.new(0.885,0,0,6)
    s.Position=UDim2.new(0.02,0,0,y+26)
    s.BackgroundColor3=hudGray03()
    s.BorderSizePixel=0
    s.Parent=hudC
    Instance.new("UICorner",s).CornerRadius=UDim.new(0,3)

    local f=Instance.new("Frame")
    f.Size=UDim2.new(initial01,0,1,0)
    f.BackgroundColor3=hudWhite()
    f.BorderSizePixel=0
    f.Parent=s
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,3)

    local h2=Instance.new("Frame")
    h2.Size=UDim2.new(0,14,0,14)
    h2.Position=UDim2.new(initial01,-7,0.5,-7)
    h2.BackgroundColor3=hudWhite()
    h2.BorderSizePixel=0
    h2.Parent=s
    Instance.new("UICorner",h2).CornerRadius=UDim.new(0,7)

    local hs=Instance.new("UIStroke")
    hs.Color=hudWhite()
    hs.Transparency=1
    hs.Thickness=1.5
    hs.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    hs.Parent=h2

    hover(s,hs)
    hover(h2,hs)

    local function set01(v)
        v=math.clamp(v,0,1)

        if kind=="alpha" then
            local raw=0.2+(1-0.2)*v
            G.hudAlpha=raw
            label.Text="HudAlpha: "..string.format("%.2f",raw)
        else
            G.hudBackgroundBrightness=v*0.5
            label.Text="HudBrightness: "..string.format("%.2f",G.hudBackgroundBrightness)
        end

        updateSlider(f,h2,v)
        updateHudBackground()
    end

    local function begin(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
        or input.UserInputType==Enum.UserInputType.Touch then

            G.isSliding=true

            if kind=="alpha" then
                G.draggingHudAlpha=true
            else
                G.draggingHudBackgroundBrightness=true
            end

            local size=s.AbsoluteSize.X
            if size>0 then
                set01(math.clamp(
                    (input.Position.X-s.AbsolutePosition.X)/size,
                    0,1
                ))
            end
        end
    end

    s.InputBegan:Connect(begin)
    h2.InputBegan:Connect(begin)

    return label,s,f,h2,set01
end

