    local boxOn=G.boxEspEnabled
    local tracerOn=G.tracersEnabled
    if not boxOn and not tracerOn then
        G.hideVisualEspDrawings()
        return
    end

    local cam=WS.CurrentCamera
    if not cam then
        G.hideVisualEspDrawings()
        return
    end

    local vp=cam.ViewportSize
    local center=vp/2
    local col=hudWhite()
    local seen={}

    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=p then
            seen[plr]=true
            local bx=G.boxEspDrawings[plr]
            local tr=G.tracerDrawings[plr]

            local char=plr.Character
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            local root=char and char:FindFirstChild("HumanoidRootPart")
            local head=char and char:FindFirstChild("Head")
            local valid=hum and hum.Health>0 and root and head and char.Parent

            if valid then
                local hp,onHead=cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.65,0))
                local fp,onFeet=cam:WorldToViewportPoint(root.Position-Vector3.new(0,hum.HipHeight+2.35,0))
                local onScreen=hp.Z>0 and fp.Z>0 and (onHead or onFeet)

                if boxOn and onScreen then
                    local topY=math.min(hp.Y,fp.Y)
                    local bottomY=math.max(hp.Y,fp.Y)
                    local bh=math.max(12,(bottomY-topY)*1.12)
                    local bw=math.max(10,bh*0.56)
                    local cx=(hp.X+fp.X)/2
                    bx=bx or G.getVisualEspDrawing(plr,"box")
                    if bx then
                        pcall(function()
                            bx.Position=Vector2.new(cx-bw/2,topY-bh*0.06)
                            bx.Size=Vector2.new(bw,bh*1.12)
                            bx.Color=col
                            bx.Transparency=G.boxEspAlpha
                            bx.Visible=true
                            bx.ZIndex=5
                        end)
                    end
                elseif bx then
                    pcall(function() bx.Visible=false end)
                end

                if tracerOn then
                    tr=tr or G.getVisualEspDrawing(plr,"tracer")
                    if tr then
                        local tracerTo=nil

                        if onScreen then
                            local cx=(hp.X+fp.X)/2
                            local cy=(hp.Y+fp.Y)/2
                            tracerTo=Vector2.new(cx,cy)
                        else
                            -- Same bearing calculation used by CrosshairArrows.
                            local rel=cam.CFrame:PointToObjectSpace(head.Position)
                            local bearing=math.atan2(rel.X,-rel.Z)
                            local dirX=math.sin(bearing)
                            local dirY=-math.cos(bearing)
                            local halfW=math.max(1,vp.X*0.5-8)
                            local halfH=math.max(1,vp.Y*0.5-8)
                            local tx=halfW/math.max(math.abs(dirX),0.0001)
                            local ty=halfH/math.max(math.abs(dirY),0.0001)
                            local radius=math.min(tx,ty)
                            tracerTo=Vector2.new(center.X+dirX*radius,center.Y+dirY*radius)
                        end

                        if tracerTo then
                            pcall(function()
                                tr.From=center
                                tr.To=tracerTo
                                tr.Color=col
                                tr.Transparency=G.tracersAlpha
                                tr.Visible=true
                                tr.ZIndex=5
                            end)
                        else
                            pcall(function() tr.Visible=false end)
                        end
                    end
                elseif tr then
                    pcall(function() tr.Visible=false end)
                end
            else
                if bx then pcall(function() bx.Visible=false end) end
                if tr then pcall(function() tr.Visible=false end) end
            end
        end
    end

    for plr,obj in pairs(G.boxEspDrawings) do
        if not seen[plr] then pcall(function() obj.Visible=false end) end
    end
    for plr,obj in pairs(G.tracerDrawings) do
        if not seen[plr] then pcall(function() obj.Visible=false end) end
    end
end

