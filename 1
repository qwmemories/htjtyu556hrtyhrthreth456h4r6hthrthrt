local function updateRgbThemeFast()
    local c=G.hudColor
    local c1=c
    local c06=themeScaled(c,0.6)
    local c05=themeScaled(c,0.5)
    local c03=themeScaled(c,0.3)
    local registry=G.hudThemeRegistry
    for i=#registry,1,-1 do
        local entry=registry[i]
        local obj=entry.object
        if obj and obj.Parent then
            local scale=entry.currentScale or entry.scale
            if entry.animStart and entry.animDuration then
                local t=math.clamp((os.clock()-entry.animStart)/entry.animDuration,0,1)
                local eased=1-(1-t)*(1-t)
                scale=entry.animFromScale+(entry.animToScale-entry.animFromScale)*eased
                entry.currentScale=scale
                if t>=1 then
                    entry.currentScale=entry.animToScale
                    entry.animFromScale=nil
                    entry.animToScale=nil
                    entry.animStart=nil
                    entry.animDuration=nil
                    scale=entry.currentScale
                end
            end
            if math.abs(scale-1)<0.001 then
                obj[entry.property]=c1
            elseif math.abs(scale-0.6)<0.001 then
                obj[entry.property]=c06
            elseif math.abs(scale-0.5)<0.001 then
                obj[entry.property]=c05
            elseif math.abs(scale-0.3)<0.001 then
                obj[entry.property]=c03
            else
                obj[entry.property]=themeScaled(c,scale)
            end
        else
            table.remove(registry,i)
        end
    end

    for stroke in pairs(G.hoveredStrokes or {}) do
        if stroke and stroke.Parent then
            stroke.Color=c1
        else
            G.hoveredStrokes[stroke]=nil
        end
    end

    colorBox.BackgroundColor3=c1
    updateHudBackground()
end

