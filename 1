    for obj,prop,value in pairs({
        [hueLabel]="TextColor3", [satLabel]="TextColor3", [brightLabel]="TextColor3",
        [hueF]="BackgroundColor3", [hueH]="BackgroundColor3",
        [satF]="BackgroundColor3", [satH]="BackgroundColor3",
        [brightF]="BackgroundColor3", [brightH]="BackgroundColor3"
    }) do
        local v=bright
        if obj==hueF or obj==satF or obj==brightF then v=track end
        themeTween(obj,prop,v,TweenInfo.new(0))
    end
end

