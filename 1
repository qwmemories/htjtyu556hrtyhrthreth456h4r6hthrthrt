function ct(p,pos)
	local t=Instance.new("Frame")
	t.Size=UDim2.new(0,46,0,22)
	t.Position=pos
	t.BackgroundColor3=Color3.new(0.15,0.15,0.15)
	t.BackgroundTransparency=0.04
