function refreshCrosshairArrows(dt)
    if not G.crosshairArrowsEnabled then
        clearCrosshairArrows()
        return
    end

    ensureCrosshairArrowsGui()

    local cam=workspace.CurrentCamera
    if not cam then return end

    dt=dt or 0.016
    local vp=cam.ViewportSize
    local centerX=vp.X*0.5
    local centerY=vp.Y*0.5

    local moving=(h and h.MoveDirection.Magnitude>0.05)
    local targetRadius=G.crosshairArrowsRadius+(moving and 18 or 0)
    local radiusBlend=1-math.exp(-dt*4.2)
    G.crosshairArrowsAnimatedRadius=G.crosshairArrowsAnimatedRadius+
        (targetRadius-G.crosshairArrowsAnimatedRadius)*radiusBlend

    local radius=G.crosshairArrowsAnimatedRadius
    local size=G.crosshairArrowsSize
    local textTransparency=1-math.clamp(G.crosshairArrowsAlpha,0,1)
    local seen={}

    local angleBlend=1-math.exp(-dt*14.0)

    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=p then
            local char=plr.Character
            local root=char and char:FindFirstChild("HumanoidRootPart")
            local head=char and char:FindFirstChild("Head")
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            if root and head and (not hum or hum.Health>0) then
                seen[plr]=true

                local label=G.crosshairArrowLabels[plr]
                if not label or not label.Parent then
                    label=Instance.new("TextLabel")
                    label.Name="PlayerArrow"
                    label.AnchorPoint=Vector2.new(0.5,0.5)
                    label.BackgroundTransparency=1
                    label.Text="▶︎"
                    label.TextColor3=hudWhite()
                    label.TextStrokeTransparency=1
                    label.Font=Enum.Font.GothamBold
                    label.TextXAlignment=Enum.TextXAlignment.Center
                    label.TextYAlignment=Enum.TextYAlignment.Center
                    label.ZIndex=10
                    label.Parent=G.crosshairArrowsGui
                    G.crosshairArrowLabels[plr]=label
                    registerHudThemeObject(label)
                end

                local rel=cam.CFrame:PointToObjectSpace(head.Position)
                local bearing=math.atan2(rel.X,-rel.Z)
                local rawAngle=math.deg(bearing)-90

                local state=G.crosshairArrowMotion[plr]
                if not state then
                    state={angle=rawAngle}
                    G.crosshairArrowMotion[plr]=state
                end

                local angleDelta=(rawAngle-state.angle+180)%360-180
                state.angle=state.angle+angleDelta*angleBlend

                local smoothBearing=math.rad(state.angle+90)

                label.Size=UDim2.fromOffset(size*2.4,size*2.4)
                label.TextSize=size
                label.TextColor3=hudWhite()
                label.TextTransparency=textTransparency
                label.Rotation=state.angle
                label.Position=UDim2.fromOffset(
                    centerX+math.sin(smoothBearing)*radius,
                    centerY-math.cos(smoothBearing)*radius
                )
                label.Visible=true
            end
        end
    end

    for plr,label in pairs(G.crosshairArrowLabels) do
        if not seen[plr] then
            if label then label:Destroy() end
            G.crosshairArrowLabels[plr]=nil
            G.crosshairArrowMotion[plr]=nil
        end
    end
end

