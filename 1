G.startAutoJump=function()
    if G.autojumpConnection then
        pcall(function() G.autojumpConnection:Disconnect() end)
        G.autojumpConnection=nil
    end
    if not G.autojumpEnabled then return end

    G.autoJumpKeyHeld=false
    G.lastAutoJumpPress=0
    G.pressSpace=function()
        local ok=false
        pcall(function()
            game:GetService("VirtualInputManager"):SendKeyEvent(true,Enum.KeyCode.Space,false,game)
            ok=true
        end)
        if not ok and type(keypress)=="function" then
            ok=pcall(keypress,0x20)
        end
        G.autoJumpKeyHeld=ok
    end
    G.releaseSpace=function()
        pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
        if type(keyrelease)=="function" then pcall(keyrelease,0x20) end
        G.autoJumpKeyHeld=false
    end

    G.pressSpace()

    -- Some games/executors do not forward a held Space key to the Humanoid.
    -- In that case, setting Jump while grounded gives the same gameplay
    -- result without waiting for a key event that may never arrive.
    G.autojumpConnection=R.Heartbeat:Connect(function()
        if not G.autojumpEnabled or not h or h.Health<=0 then return end
        local state=h:GetState()
        local now=tick()

        if state==Enum.HumanoidStateType.Landed or state==Enum.HumanoidStateType.Running then
            if now-G.lastAutoJumpPress>=0.08 then
                h.Jump=true
                G.lastAutoJumpPress=now
            end
        end

        if not G.autoJumpKeyHeld then
            G.pressSpace()
        end
    end)
end

G.stopAutoJump=function()
    if G.autojumpConnection then
        pcall(function() G.autojumpConnection:Disconnect() end)
        G.autojumpConnection=nil
    end
    if G.autoJumpKeyHeld then
        if G.releaseSpace then
            G.releaseSpace()
        else
            pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
            if type(keyrelease)=="function" then pcall(keyrelease,0x20) end
            G.autoJumpKeyHeld=false
        end
    end
end

