R.Heartbeat:Connect(function()
    if G.scriptTerminated then return end
    
    if G.speedEnabled and G.currentSpeed>0 and r and h and not G.flying then
        local vel=r.AssemblyLinearVelocity
        local moveDir=h.MoveDirection
        local speedMult=G.currentSpeed/16
        if moveDir.Magnitude>0 then
            local currentSpeed=vel.Magnitude
            local targetSpeed=16*speedMult
            if currentSpeed<targetSpeed then
                local boost=(targetSpeed-currentSpeed)*0.3
                local newVel=vel+(moveDir.Unit*boost)
                local newSpeed=newVel.Magnitude
                if newSpeed>targetSpeed then
                    newVel=newVel.Unit*targetSpeed
                end
                r.AssemblyLinearVelocity=newVel
            end
        end
    end
    
    if G.strafeEnabled and G.currentStrafe>0 and r and h and not G.flying then
        local md=h.MoveDirection
        local sp=h.WalkSpeed
        local des=md*sp
        local vel=r.AssemblyLinearVelocity
        local st=G.currentStrafe/100
        r.AssemblyLinearVelocity=Vector3.new(vel.X+(des.X-vel.X)*st,vel.Y,vel.Z+(des.Z-vel.Z)*st)
    end

    if G.airwalkEnabled and G.airwalkPlatform and r then
        G.airwalkPlatform.CFrame=CFrame.new(r.Position.X,G.airwalkY,r.Position.Z)
    end
end)

R.RenderStepped:Connect(function()
    if G.scriptTerminated then return end
    if G.flying and G.bodyVelocity and G.bodyGyro and r then
        local cam=workspace.CurrentCamera
        local move=Vector3.zero
        if U:IsKeyDown(Enum.KeyCode.W) then move=move+cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.S) then move=move-cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.A) then move=move-cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.D) then move=move+cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.Space) then move=move+Vector3.new(0,1,0) end
        if U:IsKeyDown(Enum.KeyCode.LeftControl) then move=move+Vector3.new(0,-1,0) end
        if move.Magnitude>0 then move=move.Unit*G.currentFlight end
        G.bodyVelocity.Velocity=move
        G.bodyGyro.CFrame=cam.CFrame
    end

    if G.aimbotEnabled then
        local targets={}
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=p and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") then
                local ph=plr.Character:FindFirstChildOfClass("Humanoid")
                if ph and ph.Health>0 then table.insert(targets,plr) end
            end
        end

        local target=nil
        if G.targetLockEnabled and G.lockedTarget and G.lockedTarget.Character and G.lockedTarget.Character:FindFirstChild("Head") then
            local d=(G.lockedTarget.Character.Head.Position-r.Position).Magnitude
            if d<=G.currentRange then target=G.lockedTarget else G.lockedTarget=nil end
        end

        if not target then
            if #targets>0 then
                if G.sortMode=="Distance" then
                    table.sort(targets,function(a,b)
                        local da=(a.Character.HumanoidRootPart.Position-r.Position).Magnitude
                        local db=(b.Character.HumanoidRootPart.Position-r.Position).Magnitude
                        return da<db
                    end)
                else
                    local mp=U:GetMouseLocation()
                    table.sort(targets,function(a,b)
                        local pa,oa=workspace.CurrentCamera:WorldToViewportPoint(a.Character.Head.Position)
                        local pb,ob=workspace.CurrentCamera:WorldToViewportPoint(b.Character.Head.Position)
                        if not oa then return false end
                        if not ob then return true end
                        return (Vector2.new(pa.X,pa.Y)-mp).Magnitude < (Vector2.new(pb.X,pb.Y)-mp).Magnitude
                    end)
                end
                target=targets[1]
                if G.targetLockEnabled then G.lockedTarget=target end
            end
        end

        if target and target.Character then
            local aimPart=(G.aimTarget=="Head" and target.Character:FindFirstChild("Head")) or target.Character:FindFirstChild("HumanoidRootPart")
            if aimPart then
                local d=(aimPart.Position-r.Position).Magnitude
                if d<=G.currentRange then
                    local visible=true
                    if G.wallsCheckEnabled then
                        local origin=workspace.CurrentCamera.CFrame.Position
                        local hit=workspace:Raycast(origin,aimPart.Position-origin)
                        if hit and hit.Instance then
                            local hitChar=hit.Instance:FindFirstAncestorOfClass("Model")
                            visible=hitChar and hitChar:FindFirstChildOfClass("Humanoid")~=nil
                        end
                    end
                    if visible then
                        local cam=workspace.CurrentCamera
                        if G.aimMode=="Center" then
                            local goal=CFrame.new(cam.CFrame.Position,aimPart.Position)
                            cam.CFrame=cam.CFrame:Lerp(goal,G.currentSmoothness)
                        else
                            local pos,on=cam:WorldToViewportPoint(aimPart.Position)
                            if on and mousemoverel then
                                local mp=U:GetMouseLocation()
                                mousemoverel((pos.X-mp.X)*G.currentSmoothness,(pos.Y-mp.Y)*G.currentSmoothness)
                            end
                        end
                    end
                end
            end
        end
    end
end)

