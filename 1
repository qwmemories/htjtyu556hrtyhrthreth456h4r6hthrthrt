local function applySpeed()
	if _G.speedEnabled and humanoid then humanoid.WalkSpeed=_G.currentSpeed
	elseif humanoid then humanoid.WalkSpeed=16 end
end

local function applyJump()
	if _G.jumpEnabled and humanoid then humanoid.JumpPower=_G.currentJump
	elseif humanoid then humanoid.JumpPower=50 end
end

local function setNoclip(s)
	if not character then return end
	for _,p in pairs(character:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide=not s end
	end
end

local function stopFlight()
	_G.flying=false
	if _G.bodyVelocity then _G.bodyVelocity:Destroy() _G.bodyVelocity=nil end
	if _G.bodyGyro then _G.bodyGyro:Destroy() _G.bodyGyro=nil end
	if humanoid then humanoid.PlatformStand=false end
	if _G.noclipConnection then _G.noclipConnection:Disconnect() _G.noclipConnection=nil end
	setNoclip(false)
end

local function startFlight()
	if _G.flying or not root then return end
	_G.flying=true
	_G.bodyVelocity=Instance.new("BodyVelocity")
	_G.bodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
	_G.bodyVelocity.Velocity=Vector3.zero
	_G.bodyVelocity.Parent=root
	_G.bodyGyro=Instance.new("BodyGyro")
	_G.bodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
	_G.bodyGyro.P=10000
	_G.bodyGyro.Parent=root
	humanoid.PlatformStand=true
end

local function applyFlight()
	if _G.flightEnabled then startFlight() else stopFlight() end
end

local function startAirwalk()
	if _G.airwalkPlatform then return end
	_G.airwalkY=root.Position.Y-3
	_G.airwalkPlatform=Instance.new("Part")
	_G.airwalkPlatform.Size=Vector3.new(6,1,6)
	_G.airwalkPlatform.Transparency=1
	_G.airwalkPlatform.CanCollide=true
	_G.airwalkPlatform.Anchored=true
	_G.airwalkPlatform.Parent=workspace
end

local function stopAirwalk()
	if _G.airwalkPlatform then _G.airwalkPlatform:Destroy() _G.airwalkPlatform=nil end
end

