local function syncThemeEntryToCurrentState(entry, referenceColor)
    local obj=entry.object
    if not obj or not obj.Parent then return false end
    local ok,current=pcall(function()
        return obj[entry.property]
    end)
    if not ok or typeof(current)~="Color3" then return true end
    local detected=getThemeScale(current,referenceColor)
    if not detected then
        detected=getThemeScale(current,G.hudColor)
    end
    if detected then
        entry.scale=detected
    end
    return true
end

function applyHudTheme(force)
    if not G.hudThemeEnabled or G.hudThemeUpdating then
        return
    end
    local newColor=G.hudColor
    local oldColor=G.hudThemeLastColor or newColor
    if not force and sameColor(oldColor,newColor) then
        return
    end
    G.hudThemeUpdating=true
    for i=#G.hudThemeRegistry,1,-1 do
        local entry=G.hudThemeRegistry[i]
        if not syncThemeEntryToCurrentState(entry,oldColor) then
            table.remove(G.hudThemeRegistry,i)
        else
            local obj=entry.object
            local value=themeScaled(newColor,entry.scale)
            pcall(function()
                T:Create(obj,TweenInfo.new(0),{
                    [entry.property]=value
                }):Play()
            end)
        end
    end
    G.hudThemeLastColor=newColor
    G.hudThemeUpdating=false
    if syncKeybindVisualState then
        syncKeybindVisualState()
    end
end

local function themeScaleForColor(c)
    for _,scale in ipairs(HUD_THEME_SCALES) do
        if sameColor(c,themeScaled(G.hudColor,scale)) then return scale end
    end
    return nil
end

local function untrackThemeProperty(obj,property)
    if not obj then return end
    local props=G.hudThemeRegistered[obj]
    if props then props[property]=nil end
    for i=#G.hudThemeRegistry,1,-1 do
        local entry=G.hudThemeRegistry[i]
        if entry.object==obj and entry.property==property then
            table.remove(G.hudThemeRegistry,i)
        end
    end
end

local function themeTween(obj,property,value,inf)
    if not obj or not obj.Parent then return end
    local scale=themeScaleForColor(value)
    if not scale then
        untrackThemeProperty(obj,property)
    end
    if scale then
        local props=G.hudThemeRegistered[obj]
        if not props then props={}; G.hudThemeRegistered[obj]=props end
        props[property]=true
        local found=false
        for _,entry in ipairs(G.hudThemeRegistry) do
            if entry.object==obj and entry.property==property then
                entry.scale=scale
                found=true
                break
            end
        end
        if not found then
            table.insert(G.hudThemeRegistry,{object=obj,property=property,scale=scale})
        end
    end
    pcall(function() T:Create(obj,inf,{[property]=value}):Play() end)
end

