function hookNametagPlayer(plr)
    if plr==p then return end

    if G.nametagConnections[plr] then
        pcall(function()
            G.nametagConnections[plr]:Disconnect()
        end)
    end

    G.nametagConnections[plr]=plr.CharacterAdded:Connect(function()
        task.defer(function()
            for i=1,20 do
                if not G.nametagEnabled then break end

                if plr.Character 
                and plr.Character:FindFirstChildOfClass("Humanoid") 
                and (plr.Character:FindFirstChild("Head") 
                or plr.Character:FindFirstChild("HumanoidRootPart")) then
                    
                    applyNametagToPlayer(plr)
                end

                task.wait(0.15)
            end
        end)
    end)

    if plr.CharacterAppearanceLoaded then
        pcall(function()
            G.nametagConnections[plr.."_appearance"]=plr.CharacterAppearanceLoaded:Connect(function()
                if G.nametagEnabled then
                    task.defer(function()
                        applyNametagToPlayer(plr)
                    end)
                end
            end)
        end)
    end

    if plr.Character then
        pcall(function()
            G.nametagConnections[plr.."_desc"] =
            plr.Character.DescendantAdded:Connect(function(obj)
                if not G.nametagEnabled then
                    return
                end

                if obj:IsA("Humanoid")
                or obj.Name=="Head"
                or obj:IsA("BillboardGui") then
                    task.defer(function()
                        local char=plr.Character
                        if char then
                            for _,v in ipairs(char:GetDescendants()) do
                                if v:IsA("BillboardGui")
                                and v.Name~="CustomNametag" then
                                    v.Enabled=false
                                end
                            end
                        end
                        applyNametagToPlayer(plr)
                    end)
                end
            end)
        end)
    end

    if G.nametagEnabled then
        applyNametagToPlayer(plr)
    end
end

for _,plr in ipairs(P:GetPlayers()) do
