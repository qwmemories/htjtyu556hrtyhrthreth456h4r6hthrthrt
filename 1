G.makeVisualAlphaSlider=function(parent,y,label,initial,callback)
    local ui={}
    ui.value=math.clamp(tonumber(initial) or 0,0,1)
    ui.label=Instance.new("TextLabel")
    ui.label.Size=UDim2.new(0.5,0,0,22)
    ui.label.Position=UDim2.new(0,5,0,y)
    ui.label.BackgroundTransparency=1
    ui.label.Text=label..": "..string.format("%.2f",ui.value)
    ui.label.TextColor3=hudGray06()
    ui.label.TextSize=16
    ui.label.Font=Enum.Font.Gotham
    ui.label.TextXAlignment=Enum.TextXAlignment.Left
    ui.label.Parent=parent

    ui.s=Instance.new("Frame")
    ui.s.Size=UDim2.new(0.885,0,0,6)
    ui.s.Position=UDim2.new(0.02,0,0,y+26)
    ui.s.BackgroundColor3=hudGray03()
    ui.s.BorderSizePixel=0
    ui.s.Active=true
    ui.s.Parent=parent
    Instance.new("UICorner",ui.s).CornerRadius=UDim.new(0,3)
    ui.f=Instance.new("Frame")
    ui.f.Size=UDim2.new(ui.value,0,1,0)
    ui.f.BackgroundColor3=hudGray06()
    ui.f.BorderSizePixel=0
    ui.f.Parent=ui.s
    Instance.new("UICorner",ui.f).CornerRadius=UDim.new(0,3)
    ui.h=Instance.new("Frame")
    ui.h.Size=UDim2.new(0,14,0,14)
    ui.h.Position=UDim2.new(ui.value,-7,0.5,-7)
    ui.h.BackgroundColor3=hudGray06()
    ui.h.BorderSizePixel=0
    ui.h.Active=true
    ui.h.Parent=ui.s
    Instance.new("UICorner",ui.h).CornerRadius=UDim.new(0,7)
    local function setValue(v, fire)
        v=math.clamp(tonumber(v) or 0,0,1)
        ui.value=v
        ui.f.Size=UDim2.new(v,0,1,0)
        ui.h.Position=UDim2.new(v,-7,0.5,-7)
        ui.label.Text=label..": "..string.format("%.2f",v)
        if fire and callback then callback(v) end
    end

    ui.set=function(v) setValue(v,false) end
    ui.setFromInput=function(i)
        local size=math.max(ui.s.AbsoluteSize.X,1)
        setValue((i.Position.X-ui.s.AbsolutePosition.X)/size,true)
    end
    ui.setActive=function(active,anim)
        local inf=TweenInfo.new(anim and 0.3 or 0,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
        themeTween(ui.label,"TextColor3",active and hudWhite() or hudGray06(),inf)
        themeTween(ui.s,"BackgroundColor3",active and hudGray05() or hudGray03(),inf)
        themeTween(ui.f,"BackgroundColor3",active and hudWhite() or hudGray06(),inf)
        themeTween(ui.h,"BackgroundColor3",active and hudWhite() or hudGray06(),inf)
    end
    return ui
end

