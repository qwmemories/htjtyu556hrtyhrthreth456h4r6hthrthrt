function saveFullbrightLighting()
    local L=game:GetService("Lighting")
    if G.fullbrightSaved then return end
    G.fullbrightSaved={
        Ambient=L.Ambient,
        OutdoorAmbient=L.OutdoorAmbient,
        Brightness=L.Brightness,
        ColorShift_Bottom=L.ColorShift_Bottom,
        ColorShift_Top=L.ColorShift_Top,
        FogEnd=L.FogEnd,
        GlobalShadows=L.GlobalShadows
    }
end

function restoreFullbrightLighting()
    local L=game:GetService("Lighting")
    local s=G.fullbrightSaved
    if not s then return end
    L.Ambient=s.Ambient
    L.OutdoorAmbient=s.OutdoorAmbient
    L.Brightness=s.Brightness
    L.ColorShift_Bottom=s.ColorShift_Bottom
    L.ColorShift_Top=s.ColorShift_Top
    L.FogEnd=s.FogEnd
    L.GlobalShadows=s.GlobalShadows
    G.fullbrightSaved=nil
end

function applyFullbright()
    if not G.fullbrightEnabled then return end
    local L=game:GetService("Lighting")
    saveFullbrightLighting()
    local strength=math.clamp(G.fullbrightBrightness,0,1)
    local s=G.fullbrightSaved
    if not s then return end

    L.Ambient=s.Ambient:Lerp(Color3.new(1,1,1),strength)
    L.OutdoorAmbient=s.OutdoorAmbient:Lerp(Color3.new(1,1,1),strength)
    L.Brightness=s.Brightness+(3-s.Brightness)*strength
    L.ColorShift_Bottom=s.ColorShift_Bottom:Lerp(Color3.new(1,1,1),strength)
    L.ColorShift_Top=s.ColorShift_Top:Lerp(Color3.new(1,1,1),strength)
    L.FogEnd=s.FogEnd+(100000-s.FogEnd)*strength
    if strength>0.98 then
        L.GlobalShadows=false
    else
        L.GlobalShadows=s.GlobalShadows
    end
end

function toggleFullbright()
    G.fullbrightEnabled=not G.fullbrightEnabled
    setToggle(fullbrightUI.toggle.tr,fullbrightUI.toggle.k,G.fullbrightEnabled,true)
    setFullbrightColors(G.fullbrightEnabled)
    if G.fullbrightEnabled then
        saveFullbrightLighting()
        applyFullbright()
    else
        restoreFullbrightLighting()
    end
end

