function applyTimerSpeedToAll()
    local speedToApply=G.timerIsEnabled and G.timerSpeed or 1.0
    local char=p.Character
    if char then
        local hum=char:FindFirstChild("Humanoid")
        if hum then
            local anim=hum:FindFirstChild("Animator")
            if anim then
                for _,tr in ipairs(anim:GetPlayingAnimationTracks()) do
                    tr:AdjustSpeed(speedToApply)
                end
            end
        end
    end
    for _,pl in ipairs(P:GetPlayers()) do
        if pl~=p then
            local otherChar=pl.Character
            if otherChar then
                local otherHumanoid=otherChar:FindFirstChild("Humanoid")
                if otherHumanoid then
                    local otherAnim=otherHumanoid:FindFirstChild("Animator")
                    if otherAnim then
                        for _,tr in ipairs(otherAnim:GetPlayingAnimationTracks()) do
                            tr:AdjustSpeed(speedToApply)
                        end
                    end
                end
            end
        end
    end
end

