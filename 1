hover(closeBtn,closeSt)

-- Keep the button interaction disabled during the hide/show transition, but
-- do NOT freeze the visual hover outline. MouseEnter/Leave no longer fire while
-- Active=false, so track the pointer visually and tween only when the state changes.
G.headerHoverState=G.headerHoverState or {}
local function updateHeaderButtonHover(button,stroke,key)
    if not button.Parent or not stroke.Parent then return end
    local mp=U:GetMouseLocation()
    local ap=button.AbsolutePosition
    local sz=button.AbsoluteSize
    local inside=mp.X>=ap.X and mp.X<=ap.X+sz.X and mp.Y>=ap.Y and mp.Y<=ap.Y+sz.Y
    if G.headerHoverState[key] == inside then return end
    G.headerHoverState[key]=inside
    local target=inside and 0.5 or 1
    T:Create(stroke,TweenInfo.new(0.12,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
        Transparency=target,Color=hudWhite()
    }):Play()
end
R.RenderStepped:Connect(function()
    if G.scriptTerminated then return end
    updateHeaderButtonHover(hideBtn,hideSt,"hide")
    updateHeaderButtonHover(closeBtn,closeSt,"close")
end)

