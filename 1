_G.scrollOffset=0
_G.scrollTarget=0
_G.scrollMax=0
_G.scrollDragging=false
_G.scrollDragStart=0
_G.scrollStartOffset=0

-- Deliberately tiny wheel step and very slow interpolation.
local SCROLL_STEP=3
local SCROLL_SMOOTHNESS=0.035

local function getActiveContent()
	return (_G.currentCategory=="movement") and mc or miscC
end

local function getContentBottom(content)
	local bottom=0
	for _,obj in ipairs(content:GetChildren()) do
		if obj:IsA("GuiObject") and obj.Visible then
			local y=obj.Position.Y.Offset+obj.Size.Y.Offset
			if y>bottom then bottom=y end
		end
	end
	return bottom
end

local function calculateScrollMax()
	local content=getActiveContent()
	local viewportHeight=contentViewport.AbsoluteSize.Y
	local contentBottom=getContentBottom(content)

	-- EXACT limit: the final visible GUI object's bottom is the end of scroll.
	return math.max(0,contentBottom-viewportHeight)
end

local function updateScrollBar()
	local viewportHeight=contentViewport.AbsoluteSize.Y
	local trackHeight=scrollTrack.AbsoluteSize.Y
	local content=getActiveContent()
	local contentBottom=getContentBottom(content)

	_G.scrollMax=math.max(0,contentBottom-viewportHeight)

	if _G.scrollMax<=0 or _G.isHidden or not mf.Visible then
		scrollTrack.Visible=false
		scrollThumb.Visible=false
		_G.scrollOffset=0
		_G.scrollTarget=0
		content.Position=UDim2.new(0,0,0,0)
		return
	end

	scrollTrack.Visible=true
	scrollThumb.Visible=true

	local thumbHeight=math.max(34,trackHeight*(viewportHeight/contentBottom))
	thumbHeight=math.min(trackHeight,thumbHeight)

	scrollThumb.Size=UDim2.new(1,0,0,thumbHeight)

	local travel=math.max(0,trackHeight-thumbHeight)
	local ratio=math.clamp(_G.scrollOffset/_G.scrollMax,0,1)
	scrollThumb.Position=UDim2.new(0,0,0,travel*ratio)
end

local function setScrollTarget(v)
	-- Hard clamp. The target itself can NEVER be beyond the last module.
	_G.scrollTarget=math.clamp(v,0,_G.scrollMax)
end

local function applyScroll()
	local content=getActiveContent()

	-- Clamp both target and current position before applying.
	_G.scrollMax=calculateScrollMax()
	_G.scrollTarget=math.clamp(_G.scrollTarget,0,_G.scrollMax)
	_G.scrollOffset=math.clamp(_G.scrollOffset,0,_G.scrollMax)

	content.Position=UDim2.new(0,0,-math.floor(_G.scrollOffset+0.5),0)
	updateScrollBar()
end

local function refreshScroll()
	_G.scrollMax=calculateScrollMax()
	_G.scrollTarget=math.clamp(_G.scrollTarget,0,_G.scrollMax)
	_G.scrollOffset=math.clamp(_G.scrollOffset,0,_G.scrollMax)
	applyScroll()
end

task.defer(refreshScroll)

UIS.InputChanged:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseWheel then
		if _G.isHidden or not mf.Visible or _G.scrollMax<=0 then return end

		local p=i.Position
		local vpPos=contentViewport.AbsolutePosition
		local vpSize=contentViewport.AbsoluteSize

		if p.X>=vpPos.X and p.X<=vpPos.X+vpSize.X
			and p.Y>=vpPos.Y and p.Y<=vpPos.Y+vpSize.Y then

			setScrollTarget(_G.scrollTarget-i.Position.Z*SCROLL_STEP)
		end

	elseif i.UserInputType==Enum.UserInputType.MouseMovement and _G.scrollDragging then
		local delta=i.Position.Y-_G.scrollDragStart
		local trackHeight=scrollTrack.AbsoluteSize.Y
		local thumbHeight=scrollThumb.AbsoluteSize.Y
		local travel=math.max(1,trackHeight-thumbHeight)

		setScrollTarget(_G.scrollStartOffset+(delta/travel)*_G.scrollMax)
	end
end)

scrollThumb.InputBegan:Connect(function(i)
	if not scrollThumb.Visible then return end
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		_G.scrollDragging=true
		_G.scrollDragStart=i.Position.Y
		_G.scrollStartOffset=_G.scrollTarget
	end
end)

UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		_G.scrollDragging=false
	end
end)

RS.RenderStepped:Connect(function()
	-- While minimized, force the scrollbar hidden but DO NOT destroy the
	-- scroll state. This lets it return together with the content.
	if _G.isHidden or not mf.Visible then
		scrollTrack.Visible=false
		scrollThumb.Visible=false
		return
	end

	-- Recalculate from the actual last visible module every frame.
	_G.scrollMax=calculateScrollMax()
	_G.scrollTarget=math.clamp(_G.scrollTarget,0,_G.scrollMax)
	_G.scrollOffset=math.clamp(_G.scrollOffset,0,_G.scrollMax)

	if math.abs(_G.scrollOffset-_G.scrollTarget)>0.01 then
		_G.scrollOffset=_G.scrollOffset+(_G.scrollTarget-_G.scrollOffset)*SCROLL_SMOOTHNESS
	else
		_G.scrollOffset=_G.scrollTarget
	end

	applyScroll()
end)

local function setToggle(t,k,on,anim)
	local pos=on and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
	local tc=on and Color3.new(0.5,0.5,0.5) or Color3.new(0.15,0.15,0.15)
	local kc=on and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
	if anim then
		local inf=TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
		TS:Create(k,inf,{Position=pos,BackgroundColor3=kc}):Play()
		TS:Create(t,inf,{BackgroundColor3=tc}):Play()
	else
		k.Position=pos
		k.BackgroundColor3=kc
		t.BackgroundColor3=tc
	end
end

