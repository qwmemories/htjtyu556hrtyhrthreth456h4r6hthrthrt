local function startSliderDrag(flag, updateFunc)
	return function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			_G.isSliding = true
			_G.isDragging = false
			if flag == "speed" then _G.draggingSpeed = true
			elseif flag == "jump" then _G.draggingJump = true
			elseif flag == "flight" then _G.draggingFlight = true
			elseif flag == "strafe" then _G.draggingStrafe = true
			elseif flag == "smooth" then _G.draggingSmooth = true
			elseif flag == "range" then _G.draggingRange = true end
			updateFunc(input)
		end
	end
end

speedSlider.InputBegan:Connect(startSliderDrag("speed", updateSpeedFromInput))
speedHandle.InputBegan:Connect(startSliderDrag("speed", updateSpeedFromInput))
jumpSlider.InputBegan:Connect(startSliderDrag("jump", updateJumpFromInput))
jumpHandle.InputBegan:Connect(startSliderDrag("jump", updateJumpFromInput))
flightSlider.InputBegan:Connect(startSliderDrag("flight", updateFlightFromInput))
flightHandle.InputBegan:Connect(startSliderDrag("flight", updateFlightFromInput))
strafeSlider.InputBegan:Connect(startSliderDrag("strafe", updateStrafeFromInput))
strafeHandle.InputBegan:Connect(startSliderDrag("strafe", updateStrafeFromInput))
smoothSlider.InputBegan:Connect(startSliderDrag("smooth", updateSmoothFromInput))
smoothHandle.InputBegan:Connect(startSliderDrag("smooth", updateSmoothFromInput))
rangeSlider.InputBegan:Connect(startSliderDrag("range", updateRangeFromInput))
rangeHandle.InputBegan:Connect(startSliderDrag("range", updateRangeFromInput))

UserInputService.InputChanged:Connect(function(input)
	if _G.draggingSpeed and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSpeedFromInput(input)
	end
	if _G.draggingJump and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateJumpFromInput(input)
	end
	if _G.draggingFlight and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateFlightFromInput(input)
	end
	if _G.draggingStrafe and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateStrafeFromInput(input)
	end
	if _G.draggingSmooth and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSmoothFromInput(input)
	end
	if _G.draggingRange and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateRangeFromInput(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		_G.draggingSpeed = false
		_G.draggingJump = false
		_G.draggingFlight = false
		_G.draggingStrafe = false
		_G.draggingSmooth = false
		_G.draggingRange = false
		_G.isSliding = false
	end
end)

