mainFrame.InputBegan:Connect(function(input)
	if _G.isSliding then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		_G.isDragging = true
		_G.dragStart = input.Position
		_G.startPos = mainFrame.Position
		_G.targetPos = mainFrame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if _G.isDragging and not _G.isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - _G.dragStart
		_G.targetPos = UDim2.new(_G.startPos.X.Scale, _G.startPos.X.Offset + delta.X, _G.startPos.Y.Scale, _G.startPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		_G.isDragging = false
		_G.isSliding = false
	end
end)

RunService.RenderStepped:Connect(function()
	if _G.targetPos then
		local current = mainFrame.Position
		local dx = _G.targetPos.X.Offset - current.X.Offset
		local dy = _G.targetPos.Y.Offset - current.Y.Offset
		if math.abs(dx) > 0.5 or math.abs(dy) > 0.5 then
			mainFrame.Position = UDim2.new(current.X.Scale, current.X.Offset + dx * 0.18, current.Y.Scale, current.Y.Offset + dy * 0.18)
		end
	end
end)

-- ===== СВЕРТЫВАНИЕ =====
local function setContentVisible(state)
	movementContainer.Visible = state and _G.currentCategory == "movement"
	miscContainer.Visible = state and _G.currentCategory == "misc"
	categoryBar.Visible = state
end

local function startFps()
	if _G.fpsConnection then return end
	local frames = 0
	local last = tick()
	_G.fpsConnection = RunService.RenderStepped:Connect(function()
		frames += 1
		local now = tick()
		if now - last >= 0.016 then
			fpsLabel.Text = "fps " .. math.floor(frames / (now - last))
			frames = 0
			last = now
		end
	end)
end

local function setMinimized(state)
	if _G.isAnimating then return end
	_G.isAnimating = true
	_G.isHidden = state

	local targetSize = state and UDim2.new(0, 260, 0, 30) or UDim2.new(0, 260, 0, 570)
	local tween = TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize})

	if state then
		setContentVisible(false)
		startFps()
		TweenService:Create(fpsLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	else
		TweenService:Create(fpsLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1}):Play()
	end

	tween:Play()
	tween.Completed:Connect(function()
		if not state then
			setContentVisible(true)
			if _G.fpsConnection then
				_G.fpsConnection:Disconnect()
				_G.fpsConnection = nil
			end
		end
		_G.isAnimating = false
	end)
end

hideButton.MouseButton1Click:Connect(function()
	setMinimized(not _G.isHidden)
end)

closeButton.MouseButton1Click:Connect(function()
	if _G.stopFlightFunc then _G.stopFlightFunc() end
	if _G.stopAirwalkFunc then _G.stopAirwalkFunc() end
	if _G.fpsConnection then _G.fpsConnection:Disconnect() end
	mouse.Icon = ""
	screenGui:Destroy()
end)

