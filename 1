local function startDrag(f,u)
	return function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			_G.isSliding=true
			_G.isDragging=false
			if f=="sp" then _G.draggingSpeed=true
			elseif f=="j" then _G.draggingJump=true
			elseif f=="f" then _G.draggingFlight=true
			elseif f=="st" then _G.draggingStrafe=true
			elseif f=="sm" then _G.draggingSmooth=true
			elseif f=="r" then _G.draggingRange=true end
			u(i)
		end
	end
end

