function startDrag(f,u)
    return function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            G.isSliding=true
            G.isDragging=false
            if f=="sp" then G.draggingSpeed=true
            elseif f=="j" then G.draggingJump=true
            elseif f=="f" then G.draggingFlight=true
            elseif f=="st" then G.draggingStrafe=true
            elseif f=="sm" then G.draggingSmooth=true
            elseif f=="r" then G.draggingRange=true
            elseif f=="vt" then G.draggingVisualTimer=true
            elseif f=="ac" then G.draggingCPS=true
            elseif f=="ef" then G.draggingESPFill=true
            elseif f=="eo" then G.draggingESPOutline=true
            elseif f=="ns" then G.draggingNametagSize=true
            elseif f=="nh" then G.draggingNametagHeight=true
            elseif f=="na" then G.draggingNametagAlpha=true
            elseif f=="cr" then G.draggingCrosshairRadius=true
            elseif f=="cs" then G.draggingCrosshairSize=true
            elseif f=="ca" then G.draggingCrosshairAlpha=true
            elseif f=="ba" then G.draggingBoxEspAlpha=true
            elseif f=="ta" then G.draggingTracersAlpha=true
            elseif f=="fb" then G.draggingFullbright=true end
            u(i)
        end
    end
end

