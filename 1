local scrollCurrent=0

function ac()
    if G.currentCategory=="movement" then return mc end
    if G.currentCategory=="visuals" then return visualsC end
    if G.currentCategory=="misc" then return miscC end
    if G.currentCategory=="bind" then return bindC end
    if G.currentCategory=="hud" then return hudC end
    if G.currentCategory=="client" then return G.clientC end
    return hudC
end

function cb(content)
    local bottom=0
    local lastObjY=0
    local hasVisibleSlider=false
    for _,obj in ipairs(content:GetChildren()) do
        if obj:IsA("GuiObject") and obj.Visible then
            local y=obj.Position.Y.Offset+obj.AbsoluteSize.Y
            if y>bottom then 
                bottom=y
                lastObjY=obj.Position.Y.Offset
            end
            if obj.Name and string.find(obj.Name or "", "Slider") then
                hasVisibleSlider=true
            end
        end
    end
    if hasVisibleSlider then
        return bottom+30
    end
    return bottom+10
end

function imov()
    local pos=U:GetMouseLocation()
    local apos=cv.AbsolutePosition
    local asize=cv.AbsoluteSize
    return pos.X>=apos.X and pos.X<=apos.X+asize.X and pos.Y>=apos.Y and pos.Y<=apos.Y+asize.Y
end

function cs()
    local content=ac()
    local viewportH=cv.AbsoluteSize.Y
    local bottom=cb(content)
    local canvasHeight=math.max(bottom,viewportH)
    cv.CanvasSize=UDim2.new(0,0,0,canvasHeight)
    local maxScroll=math.max(0,bottom-viewportH)
    return bottom,viewportH,maxScroll
end

function usb()
    if G.isHidden or G.isAnimating or not mf.Visible then
        scrollTrack.Visible=false
        scrollThumb.Visible=false
        return
    end
    local bottom,viewportH,maxScroll=cs()
    if maxScroll<=0 then
        scrollTarget=0
        scrollCurrent=0
        cv.CanvasPosition=Vector2.new(0,0)
        scrollTrack.Visible=false
        scrollThumb.Visible=false
        return
    end
    scrollTarget=math.clamp(scrollTarget,0,maxScroll)
    scrollCurrent=math.clamp(scrollCurrent,0,maxScroll)
    cv.CanvasPosition=Vector2.new(0,scrollCurrent)
    scrollTrack.Visible=true
    scrollThumb.Visible=true
    local trackH=scrollTrack.AbsoluteSize.Y
    local thumbH=math.clamp(trackH*(viewportH/math.max(bottom,viewportH)),36,trackH)
    scrollThumb.Size=UDim2.new(1,0,0,thumbH)
    local travel=math.max(0,trackH-thumbH)
    local ratio=maxScroll>0 and scrollCurrent/maxScroll or 0
    scrollThumb.Position=UDim2.new(0,0,0,travel*math.clamp(ratio,0,1))
end

function rs(reset)
    local _,_,maxScroll=cs()
    if reset then
        scrollTarget=0
        scrollCurrent=0
    else
        scrollTarget=math.clamp(scrollTarget,0,maxScroll)
        scrollCurrent=math.clamp(scrollCurrent,0,maxScroll)
    end
    cv.CanvasPosition=Vector2.new(0,scrollCurrent)
    usb()
end

cv.ScrollingEnabled=false

U.InputChanged:Connect(function(input)
    if input.UserInputType~=Enum.UserInputType.MouseWheel then return end
    if G.isHidden or G.isAnimating or not mf.Visible then return end
    if not imov() then return end
    local _,_,maxScroll=cs()
    if maxScroll<=0 then
        scrollTarget=0
        scrollCurrent=0
        return
    end
    scrollTarget=math.clamp(scrollTarget-input.Position.Z*SCROLL_STEP,0,maxScroll)
end)

scrollThumb.InputBegan:Connect(function(input)
    if G.isHidden or G.isAnimating then return end
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        scrollTarget=scrollCurrent
        G.scrollDragging=true
        G.scrollDragStartY=input.Position.Y
        G.scrollDragStartCanvas=scrollCurrent
    end
end)

U.InputChanged:Connect(function(input)
    if not G.scrollDragging then return end
    if input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    if not scrollTrack.Visible then return end
    local trackH=scrollTrack.AbsoluteSize.Y
    local thumbH=scrollThumb.AbsoluteSize.Y
    local travel=math.max(1,trackH-thumbH)
    local delta=input.Position.Y-G.scrollDragStartY
    local maxScroll=cs()
    local target=G.scrollDragStartCanvas+(delta/travel)*maxScroll
    scrollTarget=math.clamp(target,0,maxScroll)
    scrollCurrent=scrollTarget
    cv.CanvasPosition=Vector2.new(0,scrollCurrent)
    usb()
end)

U.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        G.scrollDragging=false
    end
end)

R.RenderStepped:Connect(function()
    if G.scriptTerminated then return end
    if G.isHidden or G.isAnimating or not mf.Visible then
        scrollTrack.Visible=false
        scrollThumb.Visible=false
        return
    end
    local _,_,maxScroll=cs()
    if maxScroll<=0 then
        scrollTarget=0
        scrollCurrent=0
        cv.CanvasPosition=Vector2.new(0,0)
        scrollTrack.Visible=false
        scrollThumb.Visible=false
        return
    end
    scrollTarget=math.clamp(scrollTarget,0,maxScroll)
    scrollCurrent=scrollCurrent+(scrollTarget-scrollCurrent)*SCROLL_SMOOTHNESS
    if math.abs(scrollCurrent-scrollTarget)<0.1 then scrollCurrent=scrollTarget end
    scrollCurrent=math.clamp(scrollCurrent,0,maxScroll)
    cv.CanvasPosition=Vector2.new(0,scrollCurrent)
    usb()
end)

