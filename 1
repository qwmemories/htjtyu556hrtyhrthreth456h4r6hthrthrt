function stopFlight()
    G.flying=false
    if G.bodyVelocity then G.bodyVelocity:Destroy() G.bodyVelocity=nil end
    if G.bodyGyro then G.bodyGyro:Destroy() G.bodyGyro=nil end
    if h then h.PlatformStand=false end
    if G.noclipConnection then G.noclipConnection:Disconnect() G.noclipConnection=nil end
    if not G.phaseEnabled then setNoclip(false) end
    setNoclipFlightColor()
end

function startFlight()
    if G.flying or not r then return end
    G.flying=true
    G.bodyVelocity=Instance.new("BodyVelocity")
    G.bodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    G.bodyVelocity.Velocity=Vector3.zero
    G.bodyVelocity.Parent=r
    G.bodyGyro=Instance.new("BodyGyro")
    G.bodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
    G.bodyGyro.P=10000
    G.bodyGyro.Parent=r
    h.PlatformStand=true
    if G.noclipEnabled or G.phaseEnabled then
        setNoclip(true)
        if not G.noclipConnection then
            G.noclipConnection=R.Stepped:Connect(function()setNoclip(true)end)
        end
    end
    setNoclipFlightColor()
end

