function getManualHudColor()
    local v=math.clamp(G.brightnessValue,0.1,1)
    return Color3.fromHSV(G.hueValue,G.saturationValue,v)
end

function rebuildHudColor()
    if G.rgbEnabled then
        local hue=G.rgbPhase%1
        local sat=math.clamp(G.rgbBrightness,0,1)
        G.hudColor=Color3.fromHSV(hue,sat,1)
    else
        G.hudColor=getManualHudColor()
    end
end

function updateHueSliderGradient()
    local sat=math.clamp(G.saturationValue,0,1)
    local val=math.clamp(G.brightnessValue,0.1,1)
    local points={
        0,1/6,2/6,3/6,4/6,5/6,1
    }
    local keys={}
    for i,hue in ipairs(points) do
        keys[i]=ColorSequenceKeypoint.new(hue,Color3.fromHSV(hue%1,sat,val))
    end
    G.hueGradient.Color=ColorSequence.new(keys)
end

