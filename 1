function updateNametagDistanceScale(dt)
    if not G.nametagEnabled then return end
    local myChar=p.Character
    local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    dt=dt or 0.016
    local blend=1-math.exp(-dt*14)
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=p then
            local char=plr.Character
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            local head=char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            local tag=head and head:FindFirstChild("CustomNametag")
            if not tag then
                applyNametagToPlayer(plr)
                char=plr.Character
                head=char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
                tag=head and head:FindFirstChild("CustomNametag")
            end
            local scaleObj=tag and tag:FindFirstChild("DistanceScale")
            if hum and head then
                hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
                hum.DisplayName=""
                pcall(function() hum.NameDisplayDistance=0 end)
            end
            if scaleObj and scaleObj:IsA("UIScale") and head then
                local distance=(myRoot.Position-head.Position).Magnitude
                local target=math.clamp(1.18-distance/180,0.68,1.18)
                local current=scaleObj.Scale
                scaleObj.Scale=current+(target-current)*blend
            end
        end
    end
end

