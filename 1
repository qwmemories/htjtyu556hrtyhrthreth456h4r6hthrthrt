local HUD_THEME_SCALES={1,0.6,0.5,0.3}
local HUD_THEME_EPS=0.002

local function themeScaled(c,scale)
    return Color3.new(
        math.clamp(c.R*scale,0,1),
        math.clamp(c.G*scale,0,1),
        math.clamp(c.B*scale,0,1)
    )
end

function hudWhite()
    return themeScaled(G.hudColor,1)
end

function hudGray06()
    return themeScaled(G.hudColor,0.6)
end

function hudGray05()
    return themeScaled(G.hudColor,0.5)
end

function hudGray03()
    return themeScaled(G.hudColor,0.3)
end

local function sameColor(a,b)
    return typeof(a)=="Color3"
       and typeof(b)=="Color3"
       and math.abs(a.R-b.R)<=HUD_THEME_EPS
       and math.abs(a.G-b.G)<=HUD_THEME_EPS
       and math.abs(a.B-b.B)<=HUD_THEME_EPS
end

local function getThemeScale(c,themeColor)
    if typeof(c)~="Color3" then return nil end
    for _,scale in ipairs(HUD_THEME_SCALES) do
        if sameColor(c,themeScaled(themeColor,scale)) then
            return scale
        end
    end
    return nil
end

local function registerProperty(obj,property)
    if not obj or not obj.Parent then return end
    local ok,current=pcall(function()
        return obj[property]
    end)
    if not ok or typeof(current)~="Color3" then return end
    local scale=getThemeScale(current,G.hudColor)
    if not scale then return end
    local props=G.hudThemeRegistered[obj]
    if not props then
        props={}
        G.hudThemeRegistered[obj]=props
    end
    if props[property] then return end
    props[property]=true
    table.insert(G.hudThemeRegistry,{
        object=obj,
        property=property,
        scale=scale
    })
end

local function registerGuiObject(obj)
    if not obj then return end
    if obj:IsA("TextLabel")
    or obj:IsA("TextButton")
    or obj:IsA("TextBox") then
        registerProperty(obj,"TextColor3")
        registerProperty(obj,"TextStrokeColor3")
    end
    if obj:IsA("Frame")
    or obj:IsA("TextLabel")
    or obj:IsA("TextButton")
    or obj:IsA("TextBox")
    or obj:IsA("ScrollingFrame")
    or obj:IsA("ViewportFrame") then
        registerProperty(obj,"BackgroundColor3")
    end
    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        registerProperty(obj,"ImageColor3")
    end
    if obj:IsA("UIStroke") then
        registerProperty(obj,"Color")
    end
end

function registerHudThemeObject(obj)
    if not obj then return obj end
    if obj:IsA("Highlight") then
        registerProperty(obj,"FillColor")
        registerProperty(obj,"OutlineColor")
    else
        registerGuiObject(obj)
    end
    return obj
end

