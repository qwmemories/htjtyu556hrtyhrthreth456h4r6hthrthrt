local function setToggleState(track, knob, isOn, animate)
	local targetKnobPos = isOn and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
	local targetTrackColor = isOn and Color3.new(0.5, 0.5, 0.5) or Color3.new(0.15, 0.15, 0.15)
	local targetKnobColor = isOn and Color3.new(1, 1, 1) or Color3.new(0.6, 0.6, 0.6)

	if animate then
		local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(knob, info, {Position = targetKnobPos, BackgroundColor3 = targetKnobColor}):Play()
		TweenService:Create(track, info, {BackgroundColor3 = targetTrackColor}):Play()
	else
		knob.Position = targetKnobPos
		knob.BackgroundColor3 = targetKnobColor
		track.BackgroundColor3 = targetTrackColor
	end
end

