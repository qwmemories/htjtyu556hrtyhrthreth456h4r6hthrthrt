	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(textLabel, info, {TextColor3 = textCol}):Play()
	if slider then TweenService:Create(slider, info, {BackgroundColor3 = sliderCol}):Play() end
	if fill then TweenService:Create(fill, info, {BackgroundColor3 = fillCol}):Play() end
