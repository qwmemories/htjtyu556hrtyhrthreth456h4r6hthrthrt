local function applySpeed()
	if speedEnabled and humanoid then humanoid.WalkSpeed = currentSpeed
	elseif humanoid then humanoid.WalkSpeed = 16 end
end

local function applyJump()
	if jumpEnabled and humanoid then humanoid.JumpPower = currentJump
	elseif humanoid then humanoid.JumpPower = 50 end
end

local function setNoclip(state)
	if not character then return end
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then part.CanCollide = not state end
	end
end

local function stopFlight()
	flying = false
	if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	if humanoid then humanoid.PlatformStand = false end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
	setNoclip(false)
	updateNoclipVisual()
end

local function startFlight()
	if flying or not root then return end
	flying = true
	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root
	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.P = 10000
	bodyGyro.Parent = root
	humanoid.PlatformStand = true
	if noclipEnabled then
		setNoclip(true)
		noclipConnection = RunService.Stepped:Connect(function() setNoclip(true) end)
	end
	updateNoclipVisual()
end

local function applyFlight()
	if flightEnabled then startFlight() else stopFlight() end
end

local function startAirwalk()
	if airwalkPlatform then return end
	airwalkY = root.Position.Y - 3
	airwalkPlatform = Instance.new("Part")
	airwalkPlatform.Size = Vector3.new(6, 1, 6)
	airwalkPlatform.Transparency = 1
	airwalkPlatform.CanCollide = true
	airwalkPlatform.Anchored = true
	airwalkPlatform.Parent = workspace
end

local function stopAirwalk()
	if airwalkPlatform then airwalkPlatform:Destroy() airwalkPlatform = nil end
end

