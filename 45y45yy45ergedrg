-- Smooth floating drag (без ограничения скорости)
mainFrame.InputBegan:Connect(function(input)
	if isSliding then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		targetPos = mainFrame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and not isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
		isSliding = false
	end
end)

RunService.RenderStepped:Connect(function()
	if targetPos then
		local current = mainFrame.Position
		local dx = targetPos.X.Offset - current.X.Offset
		local dy = targetPos.Y.Offset - current.Y.Offset
		if math.abs(dx) > 0.5 or math.abs(dy) > 0.5 then
			mainFrame.Position = UDim2.new(current.X.Scale, current.X.Offset + dx * 0.18, current.Y.Scale, current.Y.Offset + dy * 0.18)
		end
	end
end)

local function setContentVisible(state)
	movementContainer.Visible = state and currentCategory == "movement"
	miscContainer.Visible = state and currentCategory == "misc"
	categoryBar.Visible = state
end

local function startFps()
	if fpsConnection then return end
	local frames = 0
	local last = tick()
	fpsConnection = RunService.RenderStepped:Connect(function()
		frames += 1
		local now = tick()
		if now - last >= 0.016 then
			fpsLabel.Text = "fps " .. math.floor(frames / (now - last))
			frames = 0
			last = now
		end
	end)
end

local function setMinimized(state)
	if isAnimating then return end
	isAnimating = true
	isHidden = state

	local targetSize = state and UDim2.new(0, 260, 0, 30) or UDim2.new(0, 260, 0, 570)
	local tween = TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize})

	if state then
		setContentVisible(false)
		startFps()
		TweenService:Create(fpsLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	else
		TweenService:Create(fpsLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1}):Play()
	end

	tween:Play()
	tween.Completed:Connect(function()
		if not state then
			setContentVisible(true)
			if fpsConnection then
				fpsConnection:Disconnect()
				fpsConnection = nil
			end
		end
		isAnimating = false
	end)
end

hideButton.MouseButton1Click:Connect(function()
	setMinimized(not isHidden)
end)

