	local size = smoothSlider.AbsoluteSize.X
	if size <= 0 then return end
	local value = math.clamp(input.Position.X - smoothSlider.AbsolutePosition.X, 0, size) / size
	updateSliderPosition(smoothFill, smoothHandle, value)
	updateSmooth(value)
end

local function updateRangeFromInput(input)
	local size = rangeSlider.AbsoluteSize.X
	if size <= 0 then return end
	local value = math.clamp(input.Position.X - rangeSlider.AbsolutePosition.X, 0, size) / size
	updateSliderPosition(rangeFill, rangeHandle, value)
	updateRange(value)
end

local function startSliderDrag(flag, updateFunc)
	return function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isSliding = true
			isDragging = false
			if flag == "speed" then draggingSpeed = true
			elseif flag == "jump" then draggingJump = true
			elseif flag == "flight" then draggingFlight = true
			elseif flag == "strafe" then draggingStrafe = true
			elseif flag == "smooth" then draggingSmooth = true
			elseif flag == "range" then draggingRange = true end
			updateFunc(input)
		end
	end
end

